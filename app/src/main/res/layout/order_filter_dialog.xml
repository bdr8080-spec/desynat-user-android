<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/_15sdp"
    android:background="@drawable/half_rounded_corner"
    android:backgroundTint="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#FFF9ED"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/half_rounded_corner"
        android:padding="20dp"
        android:id="@+id/tvToolbar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:text="@string/filter"
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_medium"
            android:id="@+id/title"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@+id/title"
            app:layout_constraintBottom_toBottomOf="@+id/title"
            app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/close_icon"
            android:id="@+id/closeIv"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="5"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/tvToolbar">

        <RadioButton
            android:id="@+id/rbAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/all"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:paddingVertical="@dimen/_6sdp"
            android:button="@drawable/selector_checkbox_icon"
            android:paddingStart="@dimen/_10sdp"
            android:checked="false"
            app:buttonTint="@null"
            android:drawableTint="@null"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/_11sdp"/>

        <RadioButton
            android:id="@+id/rbOngoing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ongoing"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:paddingVertical="@dimen/_6sdp"
            android:button="@drawable/selector_checkbox_icon"
            android:paddingStart="@dimen/_10sdp"
            android:checked="false"
            app:buttonTint="@null"
            android:drawableTint="@null"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/_11sdp"/>

        <RadioButton
            android:id="@+id/rbDelivered"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/delivered"
            android:textColor="@color/black"
            android:paddingVertical="@dimen/_6sdp"
            android:button="@drawable/selector_checkbox_icon"
            android:paddingStart="@dimen/_10sdp"
            android:checked="false"
            app:buttonTint="@null"
            android:drawableTint="@null"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/_11sdp"/>

        <RadioButton
            android:id="@+id/rbCancelled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cancelled"
            android:textColor="@color/black"
            android:paddingVertical="@dimen/_6sdp"
            android:button="@drawable/selector_checkbox_icon"
            android:paddingStart="@dimen/_10sdp"
            android:checked="false"
            app:buttonTint="@null"
            android:drawableTint="@null"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/_11sdp"/>

        <RadioButton
            android:id="@+id/rbReturn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/return_text"
            android:textColor="@color/black"
            android:paddingVertical="@dimen/_6sdp"
            android:button="@drawable/selector_checkbox_icon"
            android:paddingStart="@dimen/_10sdp"
            android:checked="false"
            app:buttonTint="@null"
            android:drawableTint="@null"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/_11sdp"/>

    </RadioGroup>


    <TextView
        android:id="@+id/tvClear"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_15sdp"
        android:background="@drawable/button_stroke"
        android:text="@string/clear"
        android:textColor="@color/brown"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textSize="@dimen/_12sdp"
        android:paddingVertical="@dimen/_8sdp"
        android:gravity="center"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:fontFamily="@font/poppins_medium"
        app:layout_constraintTop_toBottomOf="@+id/radioGroup"
        app:layout_constraintEnd_toStartOf="@+id/tvApply"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        android:layoutDirection="ltr"/>

    <TextView
        android:id="@+id/tvApply"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_background"
        android:gravity="center"
        android:layout_marginStart="@dimen/_7sdp"
        android:text="@string/apply"
        android:layout_marginEnd="@dimen/_15sdp"
        android:fontFamily="@font/poppins_medium"
        android:paddingVertical="@dimen/_8sdp"
        android:textColor="@color/white"
        android:textSize="@dimen/_12sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvClear"
        app:layout_constraintTop_toTopOf="@+id/tvClear"
        android:layoutDirection="ltr"/>

</androidx.constraintlayout.widget.ConstraintLayout>