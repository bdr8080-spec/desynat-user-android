<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/_15sdp"
    android:background="@drawable/half_rounded_corner"
    android:backgroundTint="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_15sdp"
        android:paddingHorizontal="@dimen/_15sdp"
        android:background="@drawable/half_rounded_corner"
        android:backgroundTint="#FFF7EA"
        android:fontFamily="@font/poppins_medium"
        android:text="Filter"
        android:textColor="@color/black"
        android:drawableEnd="@drawable/close_icon"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintTop_toTopOf="parent"/>

    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="5"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/tvToolbar">

        <RadioButton
            android:id="@+id/rbAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:paddingVertical="@dimen/_6sdp"
            android:button="@drawable/selector_checkbox_icon"
            android:paddingStart="@dimen/_10sdp"
            android:checked="false"
            app:buttonTint="@null"
            android:drawableTint="@null"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/_11sdp"/>

        <RadioButton
            android:id="@+id/rbOngoing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ongoing"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:paddingVertical="@dimen/_6sdp"
            android:button="@drawable/selector_checkbox_icon"
            android:paddingStart="@dimen/_10sdp"
            android:checked="false"
            app:buttonTint="@null"
            android:drawableTint="@null"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/_11sdp"/>

        <RadioButton
            android:id="@+id/rbDelivered"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Delivered"
            android:textColor="@color/black"
            android:paddingVertical="@dimen/_6sdp"
            android:button="@drawable/selector_checkbox_icon"
            android:paddingStart="@dimen/_10sdp"
            android:checked="false"
            app:buttonTint="@null"
            android:drawableTint="@null"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/_11sdp"/>

        <RadioButton
            android:id="@+id/rbCancelled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancelled"
            android:textColor="@color/black"
            android:paddingVertical="@dimen/_6sdp"
            android:button="@drawable/selector_checkbox_icon"
            android:paddingStart="@dimen/_10sdp"
            android:checked="false"
            app:buttonTint="@null"
            android:drawableTint="@null"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/_11sdp"/>

        <RadioButton
            android:id="@+id/rbReturn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Return"
            android:textColor="@color/black"
            android:paddingVertical="@dimen/_6sdp"
            android:button="@drawable/selector_checkbox_icon"
            android:paddingStart="@dimen/_10sdp"
            android:checked="false"
            app:buttonTint="@null"
            android:drawableTint="@null"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/_11sdp"/>

    </RadioGroup>


    <TextView
        android:id="@+id/tvClear"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_15sdp"
        android:background="@drawable/button_stroke"
        android:text="Clear"
        android:textColor="@color/brown"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textSize="@dimen/_12sdp"
        android:paddingVertical="@dimen/_8sdp"
        android:gravity="center"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:fontFamily="@font/poppins_medium"
        app:layout_constraintTop_toBottomOf="@+id/radioGroup"
        app:layout_constraintEnd_toStartOf="@+id/tvApply"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvApply"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_background"
        android:gravity="center"
        android:layout_marginStart="@dimen/_7sdp"
        android:text="Apply"
        android:layout_marginEnd="@dimen/_15sdp"
        android:fontFamily="@font/poppins_medium"
        android:paddingVertical="@dimen/_8sdp"
        android:textColor="@color/white"
        android:textSize="@dimen/_12sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvClear"
        app:layout_constraintTop_toTopOf="@+id/tvClear" />


</androidx.constraintlayout.widget.ConstraintLayout>