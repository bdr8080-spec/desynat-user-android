<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.affiliateUser.auth.AffiliateAddAddressFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/llTab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="4"
        android:layout_marginTop="@dimen/_10sdp"
        android:orientation="horizontal"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_marginEnd="@dimen/_5sdp">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:layout_marginEnd="@dimen/_5sdp"
            android:src="@drawable/selected_top_bar"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:layout_marginEnd="@dimen/_10sdp"
            android:src="@drawable/selected_top_bar"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:layout_marginEnd="@dimen/_10sdp"
            android:src="@drawable/selected_top_bar"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:layout_marginEnd="@dimen/_10sdp"
            android:src="@drawable/unselected_top_bar"/>

    </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCountry"
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="@string/choose_country"
            android:layout_marginHorizontal="@dimen/_15sdp"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etCountry"
            style="@style/edit_text"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:background="@drawable/edit_back"
            android:clickable="true"
            android:editable="false"
            android:focusable="false"
            android:hint="@string/select_country"
            android:inputType="text"
            android:drawablePadding="@dimen/_5sdp"
            android:textAlignment="viewStart"
            android:drawableEnd="@drawable/ic_drop_down"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:text="@string/choose_location"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etChooseLocation"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="@string/location"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:drawableEnd="@drawable/ic_current"
            android:drawableTint="#808080"
            android:drawablePadding="@dimen/_5sdp"
            android:inputType="text"
            android:editable="false"
            android:focusable="false"
            android:clickable="true"
            android:textAlignment="viewStart"
            android:background="@drawable/edit_back"/>

    <androidx.appcompat.widget.AppCompatTextView
        style="@style/edit_text_title"
        android:layout_marginTop="@dimen/_10sdp"
        android:text="@string/address_line_1"
        android:layout_marginHorizontal="@dimen/_15sdp"/>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etAddressLine1"
        android:layout_width="match_parent"
        style="@style/edit_text"
        android:hint="@string/enter_house_no_flat_no"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:inputType="text"
        android:editable="false"
        android:focusable="false"
        android:clickable="true"
        android:textAlignment="viewStart"
        android:background="@drawable/edit_back"/>

    <androidx.appcompat.widget.AppCompatTextView
        style="@style/edit_text_title"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:text="@string/address_line_2"/>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etAddressLine2"
        android:layout_width="match_parent"
        style="@style/edit_text"
        android:hint="@string/enter_street_name_block_apartment_flat_name"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:inputType="text"
        android:editable="false"
        android:focusable="false"
        android:clickable="true"
        android:textAlignment="viewStart"
        android:background="@drawable/edit_back"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:text="@string/pin_code"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etPinCode"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="@string/enter_pin_code"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:inputType="text"
            android:textAlignment="viewStart"
            android:background="@drawable/edit_back"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:visibility="gone"
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:text="@string/locality_town"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:visibility="gone"
            android:id="@+id/etLocalityTown"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="@string/enter_locality_town"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:inputType="text"
            android:background="@drawable/edit_back"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_15sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/tvState"
                android:layout_width="0dp"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/state"
                android:layout_marginEnd="@dimen/_8sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tvCity"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:visibility="gone"
                android:id="@+id/etState"
                android:layout_width="0dp"
                style="@style/edit_text"
                android:hint="@string/enter_state_name"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="text"
                android:background="@drawable/edit_back"
                app:layout_constraintTop_toBottomOf="@+id/tvState"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/tvState"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/tvCity"
                android:layout_width="0dp"
                style="@style/edit_text_title"
                android:text="@string/city"
                android:layout_marginStart="@dimen/_7sdp"
                app:layout_constraintTop_toTopOf="@+id/tvState"
                app:layout_constraintStart_toEndOf="@+id/tvState"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:visibility="gone"
                android:id="@+id/etCity"
                android:layout_width="0dp"
                style="@style/edit_text"
                android:hint="@string/enter_city_name"
                android:inputType="text"
                android:background="@drawable/edit_back"
                app:layout_constraintTop_toTopOf="@+id/etState"
                app:layout_constraintStart_toStartOf="@+id/tvCity"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnContinue"
        style="@style/button"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="@string/continue_text"
        android:layout_marginHorizontal="@dimen/_15sdp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp"
        app:layout_constraintTop_toBottomOf="@+id/btnContinue"/>

    </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>