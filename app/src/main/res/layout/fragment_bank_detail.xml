<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.affiliateUser.auth.BankDetailFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/llTab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="4"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="horizontal"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_5sdp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="fitXY"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:src="@drawable/selected_top_bar"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="fitXY"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:src="@drawable/selected_top_bar"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="fitXY"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:src="@drawable/selected_top_bar"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="fitXY"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:src="@drawable/selected_top_bar"/>

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBankName"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="Bank Name"
                android:layout_marginHorizontal="@dimen/_15sdp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etBankName"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter Bank Name"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:inputType="textCapSentences"
                android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                android:background="@drawable/edit_back"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAccountHolderName"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="Account holder name"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etAccountHolderName"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter Account holder name"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:inputType="textCapSentences"
                android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                android:background="@drawable/edit_back"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAccountNumber"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="Account Number"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etAccountNumber"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter Account Number"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:inputType="number"
                android:maxLength="20"
                android:background="@drawable/edit_back"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvConfirmAccountNumber"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="Confirm Account Number"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etConfirmAccountNumber"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Re-Enter Account Number"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:inputType="number"
                android:maxLength="20"
                android:background="@drawable/edit_back"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvIBAN"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="IBAN"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etIban"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter IBAN"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:inputType="text"
                android:background="@drawable/edit_back"/>

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:text="SWIFT/BIC"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etSwift"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter SWIFT/BIC"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:inputType="text"
                android:maxLength="15"
                android:background="@drawable/edit_back"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnSubmit"
                style="@style/button"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="Submit"
                android:layout_marginHorizontal="@dimen/_15sdp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                app:layout_constraintTop_toBottomOf="@+id/btnContinue"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>