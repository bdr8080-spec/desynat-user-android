<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingBottom="@dimen/_15sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_15sdp"
        android:paddingHorizontal="@dimen/_15sdp"
        android:fontFamily="@font/poppins_medium"
        android:text="Filter"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:drawableStart="@drawable/ic_back"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/tvToolbar"
        app:layout_constraintBottom_toBottomOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/tvToolbar">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="16sp"
            android:text="Category"
            android:textSize="@dimen/_13sdp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="@dimen/_5sdp"
            tools:listitem="@layout/item_brand"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="2"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="16sp"
            android:text="Brand"
            android:textSize="@dimen/_13sdp" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="@dimen/_5sdp"
                tools:listitem="@layout/item_brand"
                app:layout_constraintTop_toBottomOf="@+id/tvRecentSearches"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="2"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="16sp"
            android:text="Price"
            android:textSize="@dimen/_13sdp" />

        <com.yazantarifi.slider.RangeSliderView
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:id="@+id/slider"
            app:rectangle_height="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_5sdp"
            app:slider_from_progress="299"
            app:slider_to_progress="99"
            app:corner_radius="@dimen/_1sdp"
            app:thumb_size="@dimen/_8sdp"
            app:thumb_single_color="false"
            app:slider_step_size="1"
            app:thumb_color="@color/brown"
            app:thumb_second_color="@color/brown"
            app:slider_min_value="0"
            app:slider_max_value="1000"
            app:slider_active_color="#6E4527"
            app:slider_background="#DFBF8F" />

        <com.google.android.material.slider.RangeSlider
            android:id="@+id/priceSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="100"
            app:haloRadius="0dp"
            app:thumbColor="@color/brown"
            app:thumbRadius="@dimen/_10sdp"
            app:tickVisible="false"
            app:trackColorActive="@color/brown"
            app:trackColorInactive="@color/light_brown"
            app:trackHeight="@dimen/_4sdp"
            android:valueFrom="100"
            android:valueTo="100000"
            app:labelBehavior="gone"
            app:values="@array/initial_price_values"
            android:theme="@style/WD_Slider"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvMinPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100 KD"
                android:fontFamily="@font/poppins_regular"
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/tvCentrePrice"
                android:layout_width="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/black"
                android:layout_height="wrap_content"
                android:text="50000 KD"
                android:layout_centerHorizontal="true"/>

            <TextView
                android:id="@+id/tvMaxPrice"
                android:layout_width="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/black"
                android:layout_height="wrap_content"
                android:text="100000 KD"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="16sp"
            android:text="Color"
            android:textSize="@dimen/_13sdp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="@dimen/_5sdp"
            tools:listitem="@layout/item_color_filter"
            app:layout_constraintTop_toBottomOf="@+id/tvRecentSearches"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="2"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvShowMoreColor"
            style="@style/edit_text_title"
            android:text="Show More Color"
            android:textColor="@color/brown"
            android:fontFamily="@font/poppins_medium"
            android:paddingVertical="@dimen/_10sdp"
            android:paddingEnd="@dimen/_15sdp"
            android:textSize="@dimen/_11sdp" />

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="16sp"
            android:text="Discount Range"
            android:textSize="@dimen/_13sdp" />

        <RadioGroup
            android:id="@+id/radioGroupDiscount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@+id/etFrom">

            <RadioButton
                android:id="@+id/rb10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="10%"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:paddingVertical="@dimen/_6sdp"
                android:button="@drawable/selector_checkbox_icon"
                android:paddingStart="@dimen/_8sdp"
                android:checked="false"
                app:buttonTint="@null"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"/>

            <RadioButton
                android:id="@+id/rb20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="20%"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:paddingVertical="@dimen/_6sdp"
                android:button="@drawable/selector_checkbox_icon"
                android:paddingStart="@dimen/_8sdp"
                android:checked="false"
                app:buttonTint="@null"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"/>

            <RadioButton
                android:id="@+id/rb30"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="30%"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:paddingVertical="@dimen/_6sdp"
                android:button="@drawable/selector_checkbox_icon"
                android:paddingStart="@dimen/_8sdp"
                android:checked="false"
                app:buttonTint="@null"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"/>

            <RadioButton
                android:id="@+id/rb40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="40%"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:paddingVertical="@dimen/_6sdp"
                android:button="@drawable/selector_checkbox_icon"
                android:paddingStart="@dimen/_8sdp"
                android:checked="false"
                app:buttonTint="@null"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"/>

            <RadioButton
                android:id="@+id/rb50"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="50%"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:paddingVertical="@dimen/_6sdp"
                android:button="@drawable/selector_checkbox_icon"
                android:paddingStart="@dimen/_8sdp"
                android:checked="false"
                app:buttonTint="@null"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"/>

        </RadioGroup>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="16sp"
            android:text="Size"
            android:textSize="@dimen/_13sdp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="@dimen/_5sdp"
            tools:listitem="@layout/item_brand"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="2"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="16sp"
            android:text="Ratings"
            android:textSize="@dimen/_13sdp" />

        <RadioGroup
            android:id="@+id/radioGroupRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="4"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@+id/etFrom">

            <RadioButton
                android:id="@+id/rb1Star"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1 Star"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:paddingVertical="@dimen/_6sdp"
                android:button="@drawable/selector_checkbox_icon"
                android:paddingStart="@dimen/_8sdp"
                android:checked="false"
                app:buttonTint="@null"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"/>

            <RadioButton
                android:id="@+id/rb2Star"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2 Star"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:paddingVertical="@dimen/_6sdp"
                android:button="@drawable/selector_checkbox_icon"
                android:paddingStart="@dimen/_8sdp"
                android:checked="false"
                app:buttonTint="@null"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"/>

            <RadioButton
                android:id="@+id/rb3Star"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="3 Star"
                android:textColor="@color/black"
                android:paddingVertical="@dimen/_6sdp"
                android:button="@drawable/selector_checkbox_icon"
                android:paddingStart="@dimen/_8sdp"
                android:checked="false"
                app:buttonTint="@null"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"/>

            <RadioButton
                android:id="@+id/rb4Star"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="4 Star"
                android:textColor="@color/black"
                android:paddingVertical="@dimen/_6sdp"
                android:button="@drawable/selector_checkbox_icon"
                android:paddingStart="@dimen/_8sdp"
                android:checked="false"
                app:buttonTint="@null"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"/>

            <RadioButton
                android:id="@+id/rb5Star"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="5 Star"
                android:textColor="@color/black"
                android:paddingVertical="@dimen/_6sdp"
                android:button="@drawable/selector_checkbox_icon"
                android:paddingStart="@dimen/_8sdp"
                android:checked="false"
                app:buttonTint="@null"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"/>

        </RadioGroup>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="Delivery Time"
            android:textSize="@dimen/_13sdp"/>

        <RadioGroup
            android:id="@+id/rgDeliveryTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="4"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@+id/etFrom">

            <RadioButton
                android:id="@+id/rb2Day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Today- 2 days"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:paddingVertical="@dimen/_6sdp"
                android:button="@drawable/selector_checkbox_icon"
                android:paddingStart="@dimen/_8sdp"
                android:checked="false"
                app:buttonTint="@null"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"/>

            <RadioButton
                android:id="@+id/rb3day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3- 5 days"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:paddingVertical="@dimen/_6sdp"
                android:button="@drawable/selector_checkbox_icon"
                android:paddingStart="@dimen/_8sdp"
                android:checked="false"
                app:buttonTint="@null"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"/>

            <RadioButton
                android:id="@+id/rb6day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="6- 12 days"
                android:textColor="@color/black"
                android:paddingVertical="@dimen/_6sdp"
                android:button="@drawable/selector_checkbox_icon"
                android:paddingStart="@dimen/_8sdp"
                android:checked="false"
                app:buttonTint="@null"
                android:drawableTint="@null"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"/>

        </RadioGroup>

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_15sdp">

    <TextView
        android:id="@+id/tvClear"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_15sdp"
        android:background="@drawable/button_stroke"
        android:text="Clear"
        android:textColor="@color/brown"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textSize="@dimen/_12sdp"
        android:paddingVertical="@dimen/_8sdp"
        android:gravity="center"
        android:layout_marginBottom="@dimen/_15sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:fontFamily="@font/poppins_medium"
        app:layout_constraintEnd_toStartOf="@+id/tvApply"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvApply"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_gradient"
        android:gravity="center"
        android:layout_marginStart="@dimen/_7sdp"
        android:text="Apply"
        android:fontFamily="@font/poppins_medium"
        android:paddingVertical="@dimen/_8sdp"
        android:textColor="@color/white"
        android:textSize="@dimen/_12sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvClear"
        app:layout_constraintTop_toTopOf="@+id/tvClear" />

</androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>