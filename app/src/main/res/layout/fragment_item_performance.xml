<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".ui.affiliateUser.home.product.ItemPerformanceFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivStore"
            android:layout_width="@dimen/_150sdp"
            android:layout_height="@dimen/_110sdp"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:src="@drawable/ic_placeholder"
            android:layout_marginStart="@dimen/_15sdp"
            app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/delete_icon"
            android:paddingHorizontal="@dimen/_15sdp"
            android:paddingBottom="@dimen/_20sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:maxLines="2"
            android:text="Levis Shirt (By Abaya)"
            android:textColor="@color/black"
            android:layout_marginTop="@dimen/_5sdp"
            android:textSize="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_2sdp"
            android:layout_marginStart="@dimen/_15sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/rating"
            app:layout_constraintTop_toBottomOf="@+id/ivStore" />

        <androidx.appcompat.widget.AppCompatRatingBar
            android:id="@+id/rating"
            style="@style/Widget.AppCompat.RatingBar.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:progressBackgroundTint="#C7C7C7"
            android:progressTint="#FFA41B"
            android:rating="0"
            android:secondaryProgressTint="#FFA41B"
            android:stepSize="0.5"
            android:contentDescription="@string/app_name"
            android:layout_marginEnd="@dimen/_2sdp"
            app:layout_constraintEnd_toStartOf="@+id/tvRating"
            app:layout_constraintTop_toTopOf="@+id/tvTitle"/>

        <TextView
            android:id="@+id/tvRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_15sdp"
            android:fontFamily="@font/poppins_regular"
            android:maxLines="1"
            android:layout_marginTop="@dimen/_1sdp"
            android:text="(123K)"
            android:textColor="@color/black"
            android:textSize="@dimen/_9sdp"
            app:layout_constraintTop_toTopOf="@+id/rating"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/rating"/>

        <TextView
            android:id="@+id/tvDiscountPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semi_bold"
            android:maxLines="1"
            android:text="KD 239"
            android:textColor="@color/black"
            android:textSize="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_1sdp"
            app:layout_constraintStart_toStartOf="@+id/tvTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"  />

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:maxLines="1"
            android:layout_marginTop="@dimen/_1sdp"
            android:text="KD 239"
            android:textColor="#99000000"
            android:textSize="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_5sdp"
            app:layout_constraintStart_toEndOf="@+id/tvDiscountPrice"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

        <View
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:background="#99000000"
            app:layout_constraintStart_toStartOf="@+id/tvPrice"
            app:layout_constraintEnd_toEndOf="@+id/tvPrice"
            app:layout_constraintTop_toTopOf="@+id/tvPrice"
            app:layout_constraintBottom_toBottomOf="@+id/tvPrice"/>

        <TextView
            android:id="@+id/tvDiscount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_regular"
            android:maxLines="1"
            android:layout_marginTop="@dimen/_1sdp"
            android:text="20% off"
            android:textColor="#E70000"
            android:textSize="@dimen/_10sdp"
            app:layout_constraintStart_toEndOf="@+id/tvPrice"
            app:layout_constraintTop_toTopOf="@+id/tvPrice"
            app:layout_constraintBottom_toBottomOf="@+id/tvPrice"/>

        <TextView
            android:id="@+id/tvCommission"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_light"
            android:maxLines="1"
            android:layout_marginTop="@dimen/_1sdp"
            android:text="5% Commission"
            android:textColor="@color/black"
            android:textSize="@dimen/_10sdp"
            app:layout_constraintStart_toStartOf="@+id/tvTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvPrice"/>

        <TextView
            android:id="@+id/tvLink"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:maxLines="1"
            android:layout_marginTop="@dimen/_1sdp"
            android:text="Link- off https://www.desynat.com"
            android:textColor="@color/black"
            android:textSize="@dimen/_10sdp"
            app:layout_constraintStart_toStartOf="@+id/tvTitle"
            app:layout_constraintEnd_toStartOf="@+id/ivCopy"
            app:layout_constraintTop_toBottomOf="@+id/tvCommission" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivCopy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_copy"
            android:padding="@dimen/_15sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvCommission"/>

        <TextView
            android:id="@+id/tvQuickSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:singleLine="true"
            android:text="Quick Summary"
            android:textColor="#B2000000"
            android:layout_marginTop="@dimen/_15sdp"
            android:textSize="@dimen/_12sdp"
            android:layout_marginStart="@dimen/_15sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLink" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etFrom"
            style="@style/edit_text"
            android:layout_width="0dp"
            android:paddingVertical="@dimen/_9sdp"
            android:drawablePadding="@dimen/_5sdp"
            android:hint="From   //  //"
            android:editable="false"
            android:clickable="true"
            android:background="@drawable/grey_stroke_cards"
            android:focusable="false"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginStart="@dimen/_15sdp"
            android:layout_centerVertical="true"
            android:fontFamily="@font/poppins_light"
            android:drawableEnd="@drawable/calendar_ic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/etTo"
            app:layout_constraintTop_toBottomOf="@+id/tvQuickSummary"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etTo"
            style="@style/edit_text"
            android:layout_width="0dp"
            android:paddingVertical="@dimen/_9sdp"
            android:drawablePadding="@dimen/_5sdp"
            android:hint="To   //  //"
            android:editable="false"
            android:clickable="true"
            android:background="@drawable/grey_stroke_cards"
            android:focusable="false"
            android:layout_marginEnd="@dimen/_15sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:fontFamily="@font/poppins_light"
            android:layout_centerVertical="true"
            android:drawableEnd="@drawable/calendar_ic"
            app:layout_constraintStart_toEndOf="@+id/etFrom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/etFrom"
            app:layout_constraintTop_toTopOf="@+id/etFrom"/>

        <RelativeLayout
            android:id="@+id/relClick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:padding="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:background="@drawable/grey_stroke_cards"
            app:layout_constraintTop_toBottomOf="@+id/etFrom">

            <TextView
                android:id="@+id/tvClicks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:singleLine="true"
                android:text="Total Clicks"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:layout_centerVertical="true"/>

            <TextView
                android:id="@+id/tvTotalClicks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:singleLine="true"
                android:text="0"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="textEnd"
                android:layout_toRightOf="@+id/tvClicks"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_centerVertical="true"
                android:layout_toLeftOf="@+id/ivClick"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivClick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_click"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:padding="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:background="@drawable/grey_stroke_cards"
            app:layout_constraintTop_toBottomOf="@+id/relClick">

            <TextView
                android:id="@+id/tvOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:singleLine="true"
                android:text="Total Orders"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:layout_centerVertical="true"/>

            <TextView
                android:id="@+id/tvTotalOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:singleLine="true"
                android:text="0"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="textEnd"
                android:layout_toRightOf="@+id/tvOrder"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_centerVertical="true"
                android:layout_toLeftOf="@+id/ivOrder"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_total_order"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relConversionRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:padding="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:background="@drawable/grey_stroke_cards"
            app:layout_constraintTop_toBottomOf="@+id/relOrder">

            <TextView
                android:id="@+id/tvConversion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:singleLine="true"
                android:text="Conversion rate"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:layout_centerVertical="true"/>

            <TextView
                android:id="@+id/tvConversionRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:singleLine="true"
                android:text="0%"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="textEnd"
                android:layout_toRightOf="@+id/tvConversion"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_centerVertical="true"
                android:layout_toLeftOf="@+id/ivConversionRate"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivConversionRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_conversion_rate"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relRevenue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:padding="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:background="@drawable/grey_stroke_cards"
            app:layout_constraintTop_toBottomOf="@+id/relConversionRate">

            <TextView
                android:id="@+id/tvRevenue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:singleLine="true"
                android:text="Total Revenue"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:layout_centerVertical="true"/>

            <TextView
                android:id="@+id/tvTotalRevenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:singleLine="true"
                android:text="0 KD"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="textEnd"
                android:layout_toRightOf="@+id/tvRevenue"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_centerVertical="true"
                android:layout_toLeftOf="@+id/ivRevenue"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivRevenue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_earning_revenue"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relEarnings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:padding="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:background="@drawable/grey_stroke_cards"
            app:layout_constraintTop_toBottomOf="@+id/relRevenue">

            <TextView
                android:id="@+id/tvEarnings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:singleLine="true"
                android:text="My Earnings"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:layout_centerVertical="true"/>

            <TextView
                android:id="@+id/tvMyEarnings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:singleLine="true"
                android:text="0 KD"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="textEnd"
                android:layout_toRightOf="@+id/tvEarnings"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_centerVertical="true"
                android:layout_toLeftOf="@+id/ivEarnings"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivEarnings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_earning_revenue"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_20sdp"
            app:layout_constraintTop_toBottomOf="@+id/relEarnings"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>