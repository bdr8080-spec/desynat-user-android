<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".ui.affiliateUser.home.payment.AffiliateWithdrawMoneyFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/btnSubmit">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAmount"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Amount"
                android:layout_marginHorizontal="@dimen/_15sdp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/edit_back"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvCurrency"
                    android:layout_width="wrap_content"
                    style="@style/edit_text"
                    android:background="@null"
                    android:hint="KD"
                    android:textSize="@dimen/_11sdp"
                    android:textColorHint="#80000000"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:background="#80000000"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etAmount"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:background="@null"
                    android:hint="Enter amount"
                    android:textSize="@dimen/_11sdp"
                    android:textColorHint="#80000000"
                    android:inputType="numberDecimal"/>

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="Select Account"
                android:textSize="@dimen/_12sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clAddAnotherAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/ic_add_another_account">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivAddNewBank"
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:src="@drawable/add_card"
                    android:layout_centerVertical="true"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintTop_toTopOf="@+id/tvAddNewBank"
                    app:layout_constraintBottom_toBottomOf="@+id/tvAddNewBank"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvAddNewBank"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvAddNewBank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add another account"
                    android:gravity="center"
                    android:textColor="#6F4628"
                    android:textSize="@dimen/_12sdp"
                    android:fontFamily="@font/poppins_medium"
                    android:layout_marginStart="@dimen/_5sdp"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivAddNewBank"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:listitem="@layout/item_bank"
                android:layout_marginTop="@dimen/_10sdp"
                tools:itemCount="2"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnSubmit"
        style="@style/button"
        android:layout_marginBottom="@dimen/_30sdp"
        android:layout_marginTop="@dimen/_30sdp"
        android:text="Submit Request"
        android:layout_marginHorizontal="@dimen/_15sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>