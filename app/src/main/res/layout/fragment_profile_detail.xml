<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.profile.ProfileDetailFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"
        app:layout_constraintTop_toTopOf="parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:paddingBottom="@dimen/_20sdp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_15sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvChangePassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_15sdp"
                android:paddingHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_regular"
                android:text="Change Your Password"
                android:textColor="@color/brown"
                android:textSize="@dimen/_13sdp"
                android:background="@drawable/card_background"
                android:backgroundTint="@color/light_pink"
                android:drawableEnd="@drawable/ic_arrow_forward"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>


            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfileImage"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_60sdp"
                android:src="@drawable/ic_user"
                android:scaleType="centerCrop"
                android:layout_marginTop="@dimen/_15sdp"
                app:shapeAppearanceOverlay="@style/circle_image"
                android:clipToOutline="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvChangePassword"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvChangeImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/stroke_cards"
                android:text="Change Image"
                android:paddingVertical="@dimen/_7sdp"
                android:paddingHorizontal="@dimen/_7sdp"
                android:fontFamily="@font/poppins_semi_bold"
                android:textColor="@color/brown"
                android:textSize="@dimen/_11sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ivProfileImage"
                app:layout_constraintBottom_toBottomOf="@+id/ivProfileImage"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvFullName"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="Full Name"
                app:layout_constraintTop_toBottomOf="@+id/ivProfileImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter Full Name"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="textCapSentences"
                android:maxLength="30"
                android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                android:background="@drawable/edit_back"
                app:layout_constraintTop_toBottomOf="@+id/tvFullName"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMobile"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Mobile Number"
                app:layout_constraintTop_toBottomOf="@+id/etFullName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etMobile"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Mobile Number"
                android:drawableEnd="@drawable/ic_change"
                android:drawablePadding="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="textEmailAddress"
                android:editable="false"
                android:focusable="false"
                android:clickable="true"
                android:background="@drawable/edit_color_back"
                app:layout_constraintTop_toBottomOf="@+id/tvMobile"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEmail"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Email Address"
                app:layout_constraintTop_toBottomOf="@+id/etMobile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Email Address"
                android:drawableEnd="@drawable/ic_change"
                android:drawablePadding="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:editable="false"
                android:focusable="false"
                android:clickable="true"
                android:inputType="textEmailAddress"
                android:background="@drawable/edit_color_back"
                app:layout_constraintTop_toBottomOf="@+id/tvEmail"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnSaveChange"
                style="@style/button"
                android:layout_marginBottom="@dimen/_30sdp"
                android:layout_marginTop="@dimen/_30sdp"
                android:text="Save Changes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etEmail"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>