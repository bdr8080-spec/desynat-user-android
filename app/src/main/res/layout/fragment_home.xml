<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_pink"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.fragment.HomeFragment">

    <RelativeLayout
        android:id="@+id/relToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_35sdp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAdminStory"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:src="@drawable/ic_admin_story"
            android:layout_centerVertical="true"
            app:shapeAppearanceOverlay="@style/circle_image"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDeliverTo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:text="Deliver to"
            android:textColor="@color/black"
            android:textSize="@dimen/_11sdp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_toLeftOf="@+id/ivChat"
            android:layout_toRightOf="@+id/ivAdminStory"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:hint="Fetching Location..."
            android:textColor="@color/black"
            android:textSize="@dimen/_10sdp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginEnd="@dimen/_2sdp"
            android:layout_marginStart="@dimen/_5sdp"
            android:drawableStart="@drawable/ic_loc"
            android:drawablePadding="@dimen/_2sdp"
            android:layout_below="@+id/tvDeliverTo"
            android:layout_toLeftOf="@+id/ivChat"
            android:layout_toRightOf="@+id/ivAdminStory"/>

        <ImageView
            android:id="@+id/ivNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_notification"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>

        <ImageView
            android:id="@+id/ivWishlist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_wishlist"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@+id/ivNotification"/>

        <ImageView
            android:id="@+id/ivChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_chat"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@+id/ivWishlist"/>

    </RelativeLayout>
    
    <RelativeLayout
        android:id="@+id/relSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/search_back"
        android:layout_marginTop="@dimen/_15sdp"
        android:paddingHorizontal="@dimen/_4sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        app:layout_constraintTop_toBottomOf="@+id/relToolbar">

        <androidx.appcompat.widget.AppCompatEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/edit_text"
            android:paddingVertical="@dimen/_10sdp"
            android:background="@null"
            android:drawablePadding="@dimen/_5sdp"
            android:hint="Search Product or Brand"
            android:textColorHint="@color/black"
            android:layout_centerVertical="true"
            android:drawableStart="@drawable/ic_search"
            android:layout_toLeftOf="@+id/ivCamera"/>

        <ImageView
            android:id="@+id/ivMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_mic"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>

        <ImageView
            android:id="@+id/ivCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_10sdp"
            android:background="@color/white"
            android:src="@drawable/ic_camera"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@+id/ivMic"/>

    </RelativeLayout>

   <!-- <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabIndicatorColor="@color/brown"
        app:tabTextColor="@color/black"
        app:tabIndicatorHeight="3dp"
        app:layout_constraintTop_toBottomOf="@+id/relSearch"/>-->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/llTab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="@dimen/_15sdp"
        app:layout_constraintTop_toBottomOf="@+id/relSearch">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvMen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Men"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp"
            android:gravity="center"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginTop="@dimen/_15sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvWomen"
            app:layout_constraintStart_toStartOf="parent"/>

        <View
            android:visibility="invisible"
            android:id="@+id/viewMen"
            android:layout_width="0dp"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/brown"
            app:layout_constraintTop_toBottomOf="@+id/tvMen"
            app:layout_constraintStart_toStartOf="@+id/tvMen"
            app:layout_constraintEnd_toEndOf="@+id/tvMen"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvWomen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Women"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp"
            android:gravity="center"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:fontFamily="@font/poppins_medium"
            app:layout_constraintStart_toEndOf="@+id/tvMen"
            app:layout_constraintEnd_toStartOf="@+id/tvKids"
            app:layout_constraintTop_toTopOf="@+id/tvMen"/>

        <View
            android:id="@+id/viewWomen"
            android:layout_width="0dp"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/brown"
            app:layout_constraintTop_toBottomOf="@+id/tvWomen"
            app:layout_constraintStart_toStartOf="@+id/tvWomen"
            app:layout_constraintEnd_toEndOf="@+id/tvWomen"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvKids"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Kids"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp"
            android:gravity="center"
            android:fontFamily="@font/poppins_medium"
            app:layout_constraintStart_toEndOf="@+id/tvWomen"
            app:layout_constraintTop_toTopOf="@+id/tvWomen"
            app:layout_constraintEnd_toEndOf="parent"/>

        <View
            android:visibility="invisible"
            android:id="@+id/viewKids"
            android:layout_width="0dp"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/brown"
            app:layout_constraintTop_toBottomOf="@+id/tvKids"
            app:layout_constraintStart_toStartOf="@+id/tvKids"
            app:layout_constraintEnd_toEndOf="@+id/tvKids"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_20sdp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/llTab"/>

    <!--<androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/view"
        app:layout_constraintBottom_toBottomOf="parent"/>-->

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/view"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_150sdp"
                android:layout_marginBottom="@dimen/_15sdp" />

            <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                android:id="@+id/dotsIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:dotsColor="#1A000000"
                app:dotsCornerRadius="5dp"
                app:dotsSize="10dp"
                app:dotsSpacing="3dp"
                app:dotsWidthFactor="2.2"
                app:selectedDotColor="@color/black"
                android:layout_gravity="center_horizontal"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categories"
                android:textColor="@color/black"
                android:textSize="@dimen/_14sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="@dimen/_15sdp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_categories"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_15sdp"
                tools:itemCount="6"
                app:spanCount="3"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/tvNoCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Category Found"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_regular"
                android:paddingVertical="@dimen/_30sdp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suggested Stores"
                android:textColor="@color/black"
                android:textSize="@dimen/_14sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="@dimen/_10sdp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSuggestedStore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_suggested_store"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_15sdp"
                tools:itemCount="10"
                app:spanCount="5"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Best Selling"
                android:textColor="@color/black"
                android:textSize="@dimen/_14sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="@dimen/_10sdp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBestSelling"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_top_rated"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_15sdp"
                tools:itemCount="10"
                app:spanCount="5"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browse some Premium stores"
                android:textColor="@color/black"
                android:textSize="@dimen/_14sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="@dimen/_15sdp" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerPremium"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_150sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginBottom="@dimen/_15sdp" />

            <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                android:id="@+id/dotsIndicatorPremium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:dotsColor="#1A000000"
                app:dotsCornerRadius="5dp"
                app:dotsSize="10dp"
                app:dotsSpacing="3dp"
                app:dotsWidthFactor="2.2"
                app:selectedDotColor="@color/black"
                app:progressMode="true"
                android:layout_gravity="center_horizontal"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Top Rated"
                android:textColor="@color/black"
                android:textSize="@dimen/_14sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="@dimen/_15sdp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTopRated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_top_rated"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_15sdp"
                tools:itemCount="10"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browse some discounted deals"
                android:textColor="@color/black"
                android:textSize="@dimen/_14sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="@dimen/_15sdp" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerDiscountedDeals"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_150sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginBottom="@dimen/_15sdp" />

            <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                android:id="@+id/dotsIndicatorDiscountedDeals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:dotsColor="#1A000000"
                app:dotsCornerRadius="5dp"
                app:dotsSize="10dp"
                app:dotsSpacing="3dp"
                app:dotsWidthFactor="2.2"
                app:selectedDotColor="@color/black"
                app:progressMode="true"
                android:layout_gravity="center_horizontal"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Newest Products"
                android:textColor="@color/black"
                android:textSize="@dimen/_14sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="@dimen/_15sdp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNewestProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_newest_product"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_15sdp"
                tools:itemCount="6"
                app:spanCount="2"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>