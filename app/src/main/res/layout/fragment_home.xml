<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_pink"
    android:id="@+id/clMain"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.fragment.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/relToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_35sdp"
        app:layout_constraintTop_toTopOf="parent">

        <com.desynatuser.utils.StoryImageView
            android:id="@+id/ivAdminStory"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:src="@drawable/ic_admin_story"
            android:layout_marginStart="@dimen/_1sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:visibility="gone"
            android:id="@+id/ivHighlightStory"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            app:strokeWidth="@dimen/_2sdp"
            app:strokeColor="@color/brown"
            android:clipToOutline="true"
            android:padding="@dimen/_2sdp"
            app:shapeAppearanceOverlay="@style/circle_image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDeliverTo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/deliver_to"
            android:textColor="@color/black"
            android:textSize="@dimen/_11sdp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginStart="@dimen/_5sdp"
            app:layout_constraintEnd_toStartOf="@+id/ivChat"
           app:layout_constraintStart_toEndOf="@+id/ivAdminStory"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:hint="@string/fetching_location"
            android:textColor="@color/black"
            android:textSize="@dimen/_10sdp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginEnd="@dimen/_2sdp"
            android:layout_marginStart="@dimen/_5sdp"
            android:drawableStart="@drawable/ic_loc"
            android:drawablePadding="@dimen/_2sdp"
           app:layout_constraintTop_toBottomOf="@+id/tvDeliverTo"
           app:layout_constraintEnd_toStartOf="@+id/ivChat"
            app:layout_constraintStart_toEndOf="@+id/ivAdminStory"/>

        <ImageView
            android:id="@+id/ivNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_notification"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:visibility="gone"
            android:id="@+id/relCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="@dimen/_1sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:src="@drawable/circle_cart"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:shapeAppearanceOverlay="@style/circle_image"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="visible"
                android:id="@+id/tvCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:textColor="@color/white"
                android:textSize="@dimen/_8sdp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/ivWishlist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_wishlist"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivNotification"/>

        <ImageView
            android:id="@+id/ivChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/chat_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivWishlist"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:visibility="gone"
            android:id="@+id/relChatCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="@dimen/_1sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginStart="-18dp"
            app:layout_constraintTop_toTopOf="parent"
           app:layout_constraintStart_toEndOf="@+id/ivChat">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:src="@drawable/circle_cart"
                app:shapeAppearanceOverlay="@style/circle_image"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="visible"
                android:id="@+id/tvChatCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:textColor="@color/white"
                android:textSize="@dimen/_8sdp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/relSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/search_back"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        app:layout_constraintTop_toBottomOf="@+id/relToolbar">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/edit_text"
            android:paddingVertical="@dimen/_9sdp"
            android:layout_marginStart="1dp"
            android:layout_marginVertical="1dp"
            android:background="@drawable/edit_search"
            android:drawablePadding="@dimen/_5sdp"
            android:hint="@string/search_product_or_brand"
            android:editable="false"
            android:focusable="false"
            android:singleLine="true"
            android:textColorHint="@color/black"
            android:layout_centerVertical="true"
            android:drawableStart="@drawable/ic_search"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivCamera"/>

        <ImageView
            android:id="@+id/ivMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_mic"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/ivCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_10sdp"
            android:background="@color/white"
            android:src="@drawable/ic_camera"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivMic"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

   <!-- <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabIndicatorColor="@color/brown"
        app:tabTextColor="@color/black"
        app:tabIndicatorHeight="3dp"
        app:layout_constraintTop_toBottomOf="@+id/relSearch"/>-->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/llTab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="@dimen/_15sdp"
        app:layout_constraintTop_toBottomOf="@+id/relSearch">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvMen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/men"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp"
            android:gravity="center"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginTop="@dimen/_15sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvWomen"
            app:layout_constraintStart_toStartOf="parent"/>

        <View
            android:visibility="invisible"
            android:id="@+id/viewMen"
            android:layout_width="0dp"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/brown"
            app:layout_constraintTop_toBottomOf="@+id/tvMen"
            app:layout_constraintStart_toStartOf="@+id/tvMen"
            app:layout_constraintEnd_toEndOf="@+id/tvMen"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvWomen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/women"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp"
            android:gravity="center"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:fontFamily="@font/poppins_medium"
            app:layout_constraintStart_toEndOf="@+id/tvMen"
            app:layout_constraintEnd_toStartOf="@+id/tvKids"
            app:layout_constraintTop_toTopOf="@+id/tvMen"/>

        <View
            android:id="@+id/viewWomen"
            android:layout_width="0dp"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/brown"
            app:layout_constraintTop_toBottomOf="@+id/tvWomen"
            app:layout_constraintStart_toStartOf="@+id/tvWomen"
            app:layout_constraintEnd_toEndOf="@+id/tvWomen"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvKids"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/kids"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp"
            android:gravity="center"
            android:fontFamily="@font/poppins_medium"
            app:layout_constraintStart_toEndOf="@+id/tvWomen"
            app:layout_constraintTop_toTopOf="@+id/tvWomen"
            app:layout_constraintEnd_toEndOf="parent"/>

        <View
            android:visibility="invisible"
            android:id="@+id/viewKids"
            android:layout_width="0dp"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/brown"
            app:layout_constraintTop_toBottomOf="@+id/tvKids"
            app:layout_constraintStart_toStartOf="@+id/tvKids"
            app:layout_constraintEnd_toEndOf="@+id/tvKids"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_20sdp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/llTab"/>

    <!--<androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/view"
        app:layout_constraintBottom_toBottomOf="parent"/>-->

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/view"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_150sdp"
                android:layout_marginBottom="@dimen/_3sdp" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/dotsIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:tabBackground="@drawable/tab_selector"
                app:tabGravity="center"
                app:tabIndicatorHeight="0dp"
                app:tabPaddingEnd="@dimen/_5sdp"
                android:layout_gravity="center_horizontal"
                app:layout_constraintTop_toBottomOf="@+id/viewPager"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

<!--            <com.tbuonomo.viewpagerdotsindicator.DotsIndicator-->
<!--                android:id="@+id/dotsIndicator"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                app:dotsColor="#1A000000"-->
<!--                app:dotsCornerRadius="5dp"-->
<!--                app:dotsSize="10dp"-->
<!--                app:dotsSpacing="3dp"-->
<!--                app:dotsWidthFactor="2.2"-->
<!--                app:selectedDotColor="@color/black"-->
<!--                android:layout_gravity="center_horizontal"/>-->

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/categories"
                android:textColor="@color/black"
                android:textSize="@dimen/_14sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="@dimen/_8sdp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_categories"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_15sdp"
                tools:itemCount="6"
                app:spanCount="3"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/tvNoCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_category_found"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_regular"
                android:paddingVertical="@dimen/_30sdp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/suggested_stores"
                android:textColor="@color/black"
                android:textSize="@dimen/_14sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="@dimen/_10sdp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSuggestedStore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_suggested_store"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_15sdp"
                tools:itemCount="10"
                app:spanCount="5"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="visible"
                android:id="@+id/tvNoSuggested"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_suggested_store_found"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_regular"
                android:paddingVertical="@dimen/_30sdp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/best_selling"
                android:textColor="@color/black"
                android:textSize="@dimen/_14sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="@dimen/_10sdp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBestSelling"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_top_rated"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_15sdp"
                tools:itemCount="10"
                app:spanCount="5"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="visible"
                android:id="@+id/tvNoBestSelling"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_best_selling_product_found"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_regular"
                android:paddingVertical="@dimen/_30sdp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBrowseSomePremium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/browse_some_premium_stores"
                android:textColor="@color/black"
                android:textSize="@dimen/_14sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="@dimen/_15sdp" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerPremium"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_150sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginBottom="@dimen/_3sdp" />

<!--            <com.tbuonomo.viewpagerdotsindicator.DotsIndicator-->
<!--                android:id="@+id/dotsIndicatorPremium"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                app:dotsColor="#1A000000"-->
<!--                app:dotsCornerRadius="5dp"-->
<!--                app:dotsSize="10dp"-->
<!--                app:dotsSpacing="3dp"-->
<!--                app:dotsWidthFactor="2.2"-->
<!--                app:selectedDotColor="@color/black"-->
<!--                app:progressMode="true"-->
<!--                android:layout_gravity="center_horizontal"/>-->

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/dotsIndicatorPremium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:tabBackground="@drawable/tab_selector"
                app:tabGravity="center"
                app:tabIndicatorHeight="0dp"
                app:tabPaddingEnd="@dimen/_5sdp"
                android:layout_gravity="center_horizontal"
                app:layout_constraintTop_toBottomOf="@+id/viewPager"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/top_rated"
                android:textColor="@color/black"
                android:textSize="@dimen/_14sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="@dimen/_8sdp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTopRated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_top_rated"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_15sdp"
                tools:itemCount="10"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>


            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="visible"
                android:id="@+id/tvNoTopRated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_top_rated_product_found"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_regular"
                android:paddingVertical="@dimen/_30sdp" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDealDiscounted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/browse_some_discounted_deals"
                android:textColor="@color/black"
                android:textSize="@dimen/_14sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="@dimen/_15sdp" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerDiscountedDeals"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_150sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginBottom="@dimen/_3sdp" />

<!--            <com.tbuonomo.viewpagerdotsindicator.DotsIndicator-->
<!--                android:id="@+id/dotsIndicatorDiscountedDeals"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                app:dotsColor="#1A000000"-->
<!--                app:dotsCornerRadius="5dp"-->
<!--                app:dotsSize="10dp"-->
<!--                app:dotsSpacing="3dp"-->
<!--                app:dotsWidthFactor="2.2"-->
<!--                app:selectedDotColor="@color/black"-->
<!--                app:progressMode="true"-->
<!--                android:layout_gravity="center_horizontal"/>-->

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/dotsIndicatorDiscountedDeals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:tabBackground="@drawable/tab_selector"
                app:tabGravity="center"
                app:tabIndicatorHeight="0dp"
                app:tabPaddingEnd="@dimen/_5sdp"
                android:layout_gravity="center_horizontal"
                app:layout_constraintTop_toBottomOf="@+id/viewPager"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/newest_products"
                android:textColor="@color/black"
                android:textSize="@dimen/_14sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="@dimen/_8sdp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNewestProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_newest_product"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_15sdp"
                tools:itemCount="6"
                app:spanCount="2"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="visible"
                android:id="@+id/tvNoNewest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_newest_product_found"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_regular"
                android:paddingVertical="@dimen/_30sdp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:visibility="gone"
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:indeterminate="true"
        android:indeterminateTint="@color/brown" />

    <androidx.appcompat.widget.AppCompatImageView
        android:visibility="gone"
        android:id="@+id/ivSupportBot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_support_bot"
        android:layout_marginBottom="@dimen/_20sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>