<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_pink"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.fragment.HomeFragment">

    <RelativeLayout
        android:id="@+id/relToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_35sdp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAdminStory"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:src="@drawable/ic_admin_story"
            android:layout_centerVertical="true"
            app:shapeAppearanceOverlay="@style/circle_image"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDeliverTo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:text="Deliver to"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_toLeftOf="@+id/ivChat"
            android:layout_toRightOf="@+id/ivAdminStory"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:text="Durgapur"
            android:textColor="@color/black"
            android:textSize="@dimen/_11sdp"
            android:layout_marginStart="@dimen/_5sdp"
            android:drawableStart="@drawable/ic_loc"
            android:drawablePadding="@dimen/_2sdp"
            android:layout_below="@+id/tvDeliverTo"
            android:layout_toLeftOf="@+id/ivChat"
            android:layout_toRightOf="@+id/ivAdminStory"/>


        <ImageView
            android:id="@+id/ivNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_notification"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>

        <ImageView
            android:id="@+id/ivWishlist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_wishlist"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@+id/ivNotification"/>

        <ImageView
            android:id="@+id/ivChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_chat"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@+id/ivWishlist"/>

    </RelativeLayout>
    
    <RelativeLayout
        android:id="@+id/relSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/search_back"
        android:layout_marginTop="@dimen/_15sdp"
        android:paddingHorizontal="@dimen/_4sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        app:layout_constraintTop_toBottomOf="@+id/relToolbar">

        <androidx.appcompat.widget.AppCompatEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/edit_text"
            android:paddingVertical="@dimen/_10sdp"
            android:background="@null"
            android:drawablePadding="@dimen/_5sdp"
            android:hint="Search Product or Brand"
            android:layout_centerVertical="true"
            android:drawableStart="@drawable/ic_search"
            android:layout_toLeftOf="@+id/ivCamera"/>

        <ImageView
            android:id="@+id/ivMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/ic_mic"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>

        <ImageView
            android:id="@+id/ivCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_10sdp"
            android:background="@color/white"
            android:src="@drawable/ic_camera"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@+id/ivMic"/>

    </RelativeLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabIndicatorColor="@color/brown"
        app:tabTextColor="@color/black"
        app:tabIndicatorHeight="3dp"
        app:layout_constraintTop_toBottomOf="@+id/relSearch"/>

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_20sdp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/view"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>