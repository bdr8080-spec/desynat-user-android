<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/_15sdp"
    android:background="@drawable/bottom_sheet"
    android:backgroundTint="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_15sdp"
        android:paddingHorizontal="@dimen/_15sdp"
        android:background="@drawable/bottom_sheet"
        android:backgroundTint="#FFF7EA"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/raise_ticket"
        android:textColor="@color/black"
        android:drawableEnd="@drawable/close_icon"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_15sdp"
        app:layout_constraintTop_toBottomOf="@+id/tvToolbar">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="@string/ticket_type"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etTicketType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/edit_text"
            android:fontFamily="@font/poppins_regular"
            android:textSize="@dimen/_10sdp"
            android:inputType="text"
            android:background="@drawable/edit_back"
            android:hint="@string/select_ticket_type"
            android:editable="false"
            android:clickable="true"
            android:focusable="false"
            android:drawableEnd="@drawable/ic_drop_down"
            android:drawablePadding="@dimen/_5sdp"
            android:textAlignment="viewStart"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="16sp"
            android:text="@string/title"
            android:textSize="@dimen/_13sdp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/edit_text"
            android:fontFamily="@font/poppins_regular"
            android:textSize="@dimen/_10sdp"
            android:inputType="text"
            android:background="@drawable/edit_back"
            android:hint="@string/enter_title"
            android:textAlignment="viewStart"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="16sp"
            android:text="@string/description" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/edit_text"
            android:fontFamily="@font/poppins_regular"
            android:textSize="@dimen/_10sdp"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:lines="3"
            android:background="@drawable/edit_back"
            android:hint="@string/enter_description"
            android:textAlignment="viewStart"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="16sp"
            android:text="@string/upload_attachment_if_any" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="164dp"
            android:layout_height="120dp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_5sdp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clDocument1Placeholder"
            android:layout_width="0dp"
            android:layout_height="@dimen/_90sdp"
            app:layout_constraintTop_toTopOf="@+id/ivDoc"
            app:layout_constraintBottom_toBottomOf="@+id/ivDoc"
            app:layout_constraintStart_toStartOf="@+id/ivDoc"
            app:layout_constraintEnd_toEndOf="@+id/ivDoc">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPlaceholder1"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:layout_gravity="center_horizontal"
                app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:src="@drawable/ic_gallery_placeholder_gradient"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/tvPlaceholder1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPlaceholder1"
                style="@style/edit_text_title"
                android:textColor="#875C3A"
                android:text="@string/document"
                android:textAlignment="center"
                android:textSize="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivPlaceholder1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivDoc"
            android:layout_width="164dp"
            android:layout_height="120dp"
            app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:background="@drawable/brown_dash_rectangle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_gradient"
        android:gravity="center"
        android:text="@string/submit"
        android:fontFamily="@font/poppins_medium"
        android:paddingVertical="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:textColor="@color/white"
        android:textSize="@dimen/_12sdp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>