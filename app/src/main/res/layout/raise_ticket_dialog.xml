<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/_15sdp"
    android:background="@drawable/bottom_sheet"
    android:backgroundTint="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_15sdp"
        android:paddingHorizontal="@dimen/_15sdp"
        android:background="@drawable/bottom_sheet"
        android:backgroundTint="#FFF7EA"
        android:fontFamily="@font/poppins_medium"
        android:text="Raise Ticket"
        android:textColor="@color/black"
        android:drawableEnd="@drawable/close_icon"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_15sdp"
        app:layout_constraintTop_toBottomOf="@+id/tvToolbar">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="Ticket Type"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etTicketType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/edit_text"
            android:fontFamily="@font/poppins_regular"
            android:textSize="@dimen/_10sdp"
            android:inputType="text"
            android:background="@drawable/edit_back"
            android:hint="Select Ticket Type"
            android:editable="false"
            android:clickable="true"
            android:focusable="false"
            android:drawableEnd="@drawable/ic_drop_down"
            android:drawablePadding="@dimen/_5sdp"
            android:gravity="start"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="16sp"
            android:text="Title"
            android:textSize="@dimen/_13sdp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/edit_text"
            android:fontFamily="@font/poppins_regular"
            android:textSize="@dimen/_10sdp"
            android:inputType="text"
            android:background="@drawable/edit_back"
            android:hint="Enter Title"
            android:gravity="start"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="16sp"
            android:text="Description" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/edit_text"
            android:fontFamily="@font/poppins_regular"
            android:textSize="@dimen/_10sdp"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:lines="3"
            android:background="@drawable/edit_back"
            android:hint="Enter Description"
            android:gravity="start"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="16sp"
            android:text="Upload attachment(if any)" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivDoc"
            android:layout_width="164dp"
            android:layout_height="120dp"
            android:layout_marginTop="@dimen/_5sdp"
            app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:background="@drawable/brown_dash_rectangle"
            android:src="@drawable/ic_doc"
            android:layout_marginEnd="@dimen/_5sdp"/>

        <TextView
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_gradient"
        android:gravity="center"
        android:text="Submit"
        android:fontFamily="@font/poppins_medium"
        android:paddingVertical="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:textColor="@color/white"
        android:textSize="@dimen/_12sdp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>