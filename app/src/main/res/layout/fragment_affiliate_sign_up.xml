<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.affiliateUser.auth.AffiliateSignUpFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_25sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:paddingBottom="@dimen/_10sdp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/signUp"
                android:layout_marginTop="@dimen/_10sdp"
                android:textColor="@color/black"
                android:layout_gravity="center_horizontal"
                android:textSize="@dimen/_18sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCreateAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/create_your_account"
                android:textColor="@color/brown"
                android:layout_gravity="center_horizontal"
                android:textSize="@dimen/_18sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvSignUp"/>

            <LinearLayout
                android:id="@+id/llTab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="4"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="horizontal"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_5sdp"
                app:layout_constraintTop_toBottomOf="@+id/tvCreateAccount">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="fitXY"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:src="@drawable/selected_top_bar"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="fitXY"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:src="@drawable/unselected_top_bar"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="fitXY"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:src="@drawable/unselected_top_bar"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="fitXY"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:src="@drawable/unselected_top_bar"/>

            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfile"
                android:layout_width="@dimen/_90sdp"
                android:layout_height="@dimen/_90sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_gravity="center_horizontal"
                app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:background="@drawable/grey_dash_rectangle"
                app:layout_constraintTop_toBottomOf="@+id/llTab"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clPlaceholder"
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                app:layout_constraintTop_toTopOf="@+id/ivProfile"
                app:layout_constraintBottom_toBottomOf="@+id/ivProfile"
                app:layout_constraintStart_toStartOf="@+id/ivProfile"
                app:layout_constraintEnd_toEndOf="@+id/ivProfile">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPlaceholder"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_gravity="center_horizontal"
                    app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:src="@drawable/ic_gallery_placeholder"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/tvPlaceholder"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPlaceholder"
                    style="@style/edit_text_title"
                    android:textColor="@color/black"
                    android:text="@string/upload_profile_nphoto"
                    android:textAlignment="center"
                    android:textSize="@dimen/_10sdp"
                    android:alpha="0.6"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivPlaceholder"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvFullName"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="@string/full_name"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@+id/ivProfile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:textAlignment="viewStart"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="@string/enter_full_name"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="textCapSentences"
                android:maxLength="30"
                android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                android:background="@drawable/edit_back"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@+id/tvFullName"
                android:textAlignment="viewStart"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMobile"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/mobile_number"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@+id/etFullName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:textAlignment="viewStart"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:paddingHorizontal="@dimen/_10sdp"
                android:background="@drawable/edit_back"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@+id/tvMobile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvCountryPicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="+965"
                    android:paddingVertical="@dimen/_10sdp"
                    android:drawableEnd="@drawable/ic_drop_down"
                    android:drawablePadding="@dimen/_5sdp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/etMobile"
                    app:layout_constraintBottom_toBottomOf="@+id/etMobile"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etMobile"
                    android:layout_width="0dp"
                    style="@style/edit_text"
                    android:hint="@string/enter_mobile_number"
                    android:inputType="number"
                    android:maxLength="15"
                    android:background="@null"
                    android:paddingHorizontal="0dp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvCountryPicker"
                    android:textAlignment="viewStart"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEmail"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/email_address"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@+id/clMobile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:textAlignment="viewStart"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="@string/enter_email_address"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="textEmailAddress"
                android:background="@drawable/edit_back"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@+id/tvEmail"
                android:textAlignment="viewStart"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDocument"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/upload_document"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@+id/etEmail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:textAlignment="viewStart"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clDocument1Placeholder"
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                app:layout_constraintTop_toTopOf="@+id/ivDoc1"
                app:layout_constraintBottom_toBottomOf="@+id/ivDoc1"
                app:layout_constraintStart_toStartOf="@+id/ivDoc1"
                app:layout_constraintEnd_toEndOf="@+id/ivDoc1">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPlaceholder1"
                    android:layout_width="@dimen/_35sdp"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_gravity="center_horizontal"
                    app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:src="@drawable/ic_gallery_placeholder_gradient"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/tvPlaceholder1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPlaceholder1"
                    style="@style/edit_text_title"
                    android:textColor="#875C3A"
                    android:text="@string/document_1"
                    android:textAlignment="center"
                    android:textSize="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivPlaceholder1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDoc1"
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                android:layout_marginTop="@dimen/_5sdp"
                app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:background="@drawable/brown_dash_rectangle"
                android:layout_marginEnd="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@+id/tvDocument"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ivDoc2"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clDocument2Placeholder"
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                app:layout_constraintTop_toTopOf="@+id/ivDoc2"
                app:layout_constraintBottom_toBottomOf="@+id/ivDoc2"
                app:layout_constraintStart_toStartOf="@+id/ivDoc2"
                app:layout_constraintEnd_toEndOf="@+id/ivDoc2">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPlaceholder2"
                    android:layout_width="@dimen/_35sdp"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_gravity="center_horizontal"
                    app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:src="@drawable/ic_gallery_placeholder_gradient"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/tvPlaceholder2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPlaceholder2"
                    style="@style/edit_text_title"
                    android:textColor="#875C3A"
                    android:text="@string/document_2"
                    android:textAlignment="center"
                    android:textSize="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivPlaceholder2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDoc2"
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:background="@drawable/brown_dash_rectangle"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                app:layout_constraintTop_toTopOf="@+id/ivDoc1"
                app:layout_constraintBottom_toBottomOf="@+id/ivDoc1"
                app:layout_constraintStart_toEndOf="@+id/ivDoc1"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPassword"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/create_password"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivDoc1"
                android:textAlignment="viewStart"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/relPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/edit_back"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvPassword">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    style="@style/edit_text"
                    android:hint="@string/enter_password"
                    android:inputType="textPassword"
                    android:background="@null"
                    android:textAlignment="viewStart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ivPasswordVisible"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivPasswordVisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_10sdp"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/hint_color"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvConfirmPassword"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/confirm_password"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/relPassword"
                android:textAlignment="viewStart"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/relConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/edit_back"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvConfirmPassword">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="0dp"
                    style="@style/edit_text"
                    android:hint="@string/enter_confirm_password"
                    android:inputType="textPassword"
                    android:background="@null"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ivConfirmPasswordVisible"
                    android:textAlignment="viewStart"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivConfirmPasswordVisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_10sdp"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/hint_color"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <CheckBox
                android:id="@+id/cbTermsPolicy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:padding="@dimen/_8sdp"
                android:layout_marginStart="@dimen/_15sdp"
                android:button="@drawable/selector_checkbox_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/relConfirmPassword"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTermsPolicy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:text="@string/i_accept_the_terms_conditions_and_policies"
                app:layout_constraintStart_toEndOf="@+id/cbTermsPolicy"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/cbTermsPolicy"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnContinue"
                style="@style/button"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="@string/continue_text"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cbTermsPolicy"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAlreadyAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/_10sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:fontFamily="@font/poppins_regular"
                android:textAlignment="center"
                android:text="@string/already_have_an_account_sign_in"
                android:textColor="@color/black"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintTop_toBottomOf="@+id/btnContinue"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                app:layout_constraintTop_toBottomOf="@+id/tvAlreadyAccount"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>