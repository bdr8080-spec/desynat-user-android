<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_background"
        android:backgroundTint="@color/white"
        android:layout_margin="@dimen/_10sdp"
        android:paddingBottom="@dimen/_10sdp"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_10sdp"
        android:paddingHorizontal="@dimen/_15sdp"
        android:background="@drawable/bottom_sheet"
        android:backgroundTint="#FFF7EA"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/affiliate_link"
        android:textColor="@color/black"
        android:drawableEnd="@drawable/close_icon"
        android:textSize="@dimen/_13sdp"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLink"
        android:layout_width="match_parent"
        style="@style/edit_text"
        android:layout_marginTop="@dimen/_20sdp"
        android:padding="@dimen/_8sdp"
        android:textSize="@dimen/_11sdp"
        android:background="@drawable/button_stroke"
        android:layout_marginHorizontal="@dimen/_10sdp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCopyLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ic_copy_link"
            android:text="@string/copy_link"
            android:textColor="@color/black"
            android:textSize="@dimen/_11sdp"
            android:fontFamily="@font/poppins_medium"
            android:layout_gravity="end"
            android:gravity="center"
            android:layout_marginEnd="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnAdd"
        style="@style/button"
        android:layout_marginTop="@dimen/_30sdp"
        android:text="@string/add_to_products"
        android:padding="@dimen/_8sdp"
        android:textSize="@dimen/_11sdp"
        android:layout_marginHorizontal="@dimen/_10sdp"/>

</LinearLayout>

    </LinearLayout>

</RelativeLayout>