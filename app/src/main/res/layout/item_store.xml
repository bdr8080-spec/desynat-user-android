<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/_6sdp"
    android:layout_marginBottom="@dimen/_12sdp"
    android:paddingBottom="@dimen/_6sdp"
    android:background="@drawable/card_background6"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivStore"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_80sdp"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        android:src="@drawable/toprated"
        android:layout_marginHorizontal="1dp"
        android:layout_marginTop="1dp"
        app:shapeAppearanceOverlay="@style/half_rounded_corner_6sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivProfile"
        android:layout_width="@dimen/_18sdp"
        android:layout_height="@dimen/_18sdp"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        android:src="@drawable/toprated"
        app:shapeAppearanceOverlay="@style/circle_image"
        app:layout_constraintTop_toTopOf="@+id/ivStoryHighlight"
        app:layout_constraintEnd_toEndOf="@+id/ivStoryHighlight"
        app:layout_constraintBottom_toBottomOf="@+id/ivStoryHighlight"
        app:layout_constraintStart_toStartOf="@+id/ivStoryHighlight" />

    <com.google.android.material.imageview.ShapeableImageView
        android:visibility="invisible"
        android:id="@+id/ivStoryHighlight"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        app:strokeColor="@color/brown"
        app:shapeAppearanceOverlay="@style/circle_image"
        app:strokeWidth="@dimen/_2sdp"
        android:padding="@dimen/_1sdp"
        android:layout_marginStart="@dimen/_2sdp"
        app:layout_constraintTop_toTopOf="@+id/tvName"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:singleLine="true"
        android:text="Atif Aslam"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/_5sdp"
        android:textSize="@dimen/_8sdp"
        android:textAlignment="viewStart"
        android:layout_marginHorizontal="@dimen/_2sdp"
        app:layout_constraintStart_toEndOf="@+id/ivStoryHighlight"
        app:layout_constraintEnd_toStartOf="@+id/tvStatus"
        app:layout_constraintTop_toBottomOf="@+id/ivStore" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:text="@string/busy"
        android:textSize="@dimen/_6sdp"
        android:paddingHorizontal="@dimen/_2sdp"
        android:background="@drawable/btn_gradient"
        android:backgroundTint="#1FD53B36"
        android:textColor="#D53B36"
        android:layout_marginHorizontal="@dimen/_2sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvName" />

    <androidx.appcompat.widget.AppCompatRatingBar
        android:id="@+id/rating"
        style="@style/Widget.AppCompat.RatingBar.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:progressBackgroundTint="#C7C7C7"
        android:progressTint="#FFA41B"
        android:rating="0"
        android:scaleX="0.9"
        android:scaleY="0.9"
        android:contentDescription="@string/app_name"
        android:layout_marginTop="@dimen/_2sdp"
        android:layout_marginStart="@dimen/_1sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivStoryHighlight"/>

    <TextView
        android:id="@+id/tvRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_1sdp"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_regular"
        android:maxLines="1"
        android:layout_marginTop="@dimen/_1sdp"
        android:text="(0)"
        android:textColor="@color/black"
        android:textSize="@dimen/_7sdp"
        app:layout_constraintStart_toEndOf="@+id/rating"
        app:layout_constraintTop_toTopOf="@+id/rating"
        app:layout_constraintBottom_toBottomOf="@+id/rating"/>

</androidx.constraintlayout.widget.ConstraintLayout>