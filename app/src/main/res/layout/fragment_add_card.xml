<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".ui.home.card.AddCardFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/btnSave">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_15sdp"
        app:layout_constraintTop_toBottomOf="@+id/tvToolbar">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="@string/card_holder_name"
            android:textAlignment="viewStart"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etCardHolderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/edit_text"
            android:fontFamily="@font/poppins_regular"
            android:inputType="textCapSentences"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@drawable/edit_back"
            android:hint="@string/card_holder_name"
            android:textAlignment="viewStart"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="16sp"
            android:text="@string/card_number"
            android:textAlignment="viewStart"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etCardNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/edit_text"
            android:fontFamily="@font/poppins_regular"
            android:inputType="number"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@drawable/edit_back"
            android:hint="@string/card_number"
            android:maxLength="16"
            android:textAlignment="viewStart"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="16sp"
            android:text="@string/expiry_date"
            android:textAlignment="viewStart"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="3"
            android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etExpiryDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            style="@style/edit_text"
            android:fontFamily="@font/poppins_regular"
            android:clickable="true"
            android:editable="false"
            android:focusable="false"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@drawable/edit_back"
            android:hint="@string/expiry_date"
            android:textAlignment="viewStart"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etCvv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/edit_text"
            android:layout_marginStart="@dimen/_15sdp"
            android:fontFamily="@font/poppins_regular"
            android:inputType="number"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@drawable/edit_back"
            android:hint="@string/cvv"
            android:maxLength="3"
            android:textAlignment="viewStart"/>

        </LinearLayout>

        <CheckBox
            android:id="@+id/cbFuture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:textSize="@dimen/_10sdp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/black"
            android:padding="@dimen/_5sdp"
            android:textAlignment="viewStart"
            android:button="@drawable/selector_checkbox_icon"
            android:text="@string/check_card_for_future"/>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_gradient"
        android:gravity="center"
        android:text="@string/save"
        android:fontFamily="@font/poppins_medium"
        android:paddingVertical="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginBottom="@dimen/_30sdp"
        android:textColor="@color/white"
        android:textSize="@dimen/_12sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>