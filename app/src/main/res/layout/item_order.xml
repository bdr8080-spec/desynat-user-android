<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_15sdp"
    android:paddingBottom="@dimen/_10sdp"
    android:background="@drawable/card_background"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivProduct"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_80sdp"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        android:src="@drawable/toprated"
        android:layout_margin="@dimen/_10sdp"
        app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_regular"
        android:text="Ongoing"
        android:textColor="#FF5F1B"
        android:layout_margin="1dp"
        android:textSize="@dimen/_11sdp"
        android:paddingStart="@dimen/_10sdp"
        android:paddingEnd="@dimen/_6sdp"
        android:paddingTop="@dimen/_2sdp"
        android:paddingBottom="@dimen/_2sdp"
        android:background="@drawable/order_status_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:singleLine="true"
        android:text="Mooei 3 Pcs set"
        android:textColor="@color/black"
        android:textSize="@dimen/_11sdp"
        android:layout_marginHorizontal="@dimen/_10sdp"
        app:layout_constraintStart_toEndOf="@+id/ivProduct"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvOrderId" />

    <TextView
        android:id="@+id/tvOrderId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:singleLine="true"
        android:text="Order ID: #256398"
        android:textColor="@color/black"
        android:textSize="@dimen/_11sdp"
        android:layout_marginHorizontal="@dimen/_10sdp"
        app:layout_constraintStart_toEndOf="@+id/ivProduct"
        app:layout_constraintEnd_toStartOf="@+id/tvPrice"
        app:layout_constraintTop_toTopOf="@+id/ivProduct" />

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_semi_bold"
        android:maxLines="1"
        android:text="155 KD"
        android:textColor="@color/black"
        android:textSize="@dimen/_11sdp"
        android:layout_marginEnd="@dimen/_10sdp"
       app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvOrderId" />

    <TextView
        android:id="@+id/tvSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_light"
        android:text="Size: "
        android:textColor="@color/black"
        android:textSize="@dimen/_9sdp"
        app:layout_constraintStart_toStartOf="@+id/tvTitle"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

    <TextView
        android:id="@+id/tvSizeValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_light"
        android:text="M"
        android:textColor="@color/black"
        android:textSize="@dimen/_9sdp"
        app:layout_constraintStart_toEndOf="@+id/tvSize"
        app:layout_constraintTop_toTopOf="@+id/tvSize"
        app:layout_constraintBottom_toBottomOf="@+id/tvSize"/>

    <TextView
        android:id="@+id/tvColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_light"
        android:text="Color"
        android:drawableStart="@drawable/ic_cart_dot"
        android:drawablePadding="@dimen/_3sdp"
        android:textColor="@color/black"
        android:textSize="@dimen/_9sdp"
        android:layout_marginStart="@dimen/_5sdp"
        app:layout_constraintStart_toEndOf="@+id/tvSizeValue"
        app:layout_constraintTop_toTopOf="@+id/tvSize"
        app:layout_constraintBottom_toBottomOf="@+id/tvSize"/>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivColor"
        android:layout_width="@dimen/_10sdp"
        android:layout_height="@dimen/_10sdp"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        android:src="@color/light_brown"
        android:layout_marginStart="@dimen/_5sdp"
        app:shapeAppearanceOverlay="@style/rounded_corner2sdp"
        app:layout_constraintTop_toTopOf="@+id/tvSize"
        app:layout_constraintBottom_toBottomOf="@+id/tvSize"
        app:layout_constraintStart_toEndOf="@+id/tvColor"/>

    <TextView
        android:id="@+id/tvQnt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_light"
        android:text="Qnt: "
        android:textColor="@color/black"
        android:textSize="@dimen/_9sdp"
        android:layout_marginStart="@dimen/_5sdp"
        android:drawableStart="@drawable/ic_cart_dot"
        android:drawablePadding="@dimen/_3sdp"
        app:layout_constraintStart_toEndOf="@+id/ivColor"
        app:layout_constraintTop_toTopOf="@+id/tvSize"
        app:layout_constraintBottom_toBottomOf="@+id/tvSize"/>

    <TextView
        android:id="@+id/tvQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_light"
        android:text="1"
        android:textColor="@color/black"
        android:textSize="@dimen/_9sdp"
        app:layout_constraintStart_toEndOf="@+id/tvQnt"
        app:layout_constraintTop_toTopOf="@+id/tvSize"
        app:layout_constraintBottom_toBottomOf="@+id/tvSize"/>

    <TextView
        android:id="@+id/tvPlaced"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_light"
        android:maxLines="1"
        android:text="Placed"
        android:textColor="@color/black"
        android:textSize="@dimen/_10sdp"
        app:layout_constraintStart_toStartOf="@+id/tvTitle"
        app:layout_constraintTop_toBottomOf="@+id/tvSize" />

    <TextView
        android:id="@+id/tvPlacedDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_regular"
        android:maxLines="1"
        android:text="7PM  | 21 02 25"
        android:textColor="@color/black"
        android:textSize="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvPlaced"/>


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btn"
        style="@style/button"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:backgroundTint="#F4DDDD"
        android:padding="@dimen/_8sdp"
        android:textColor="#17854C"
        android:fontFamily="@font/poppins_light"
        android:text="Expected Delivery Date : 12 SEP 25"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivProduct"/>

</androidx.constraintlayout.widget.ConstraintLayout>