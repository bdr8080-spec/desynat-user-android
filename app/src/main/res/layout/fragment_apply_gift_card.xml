<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.giftCard.ApplyGiftCardFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/btnRedeem">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/_15sdp">

        <androidx.appcompat.widget.AppCompatTextView
        style="@style/edit_text_title"
        android:layout_marginTop="@dimen/_15sdp"
        android:text="Enter Gift Card Details"
        android:textSize="@dimen/_13sdp"
        android:textColor="@color/black"
        android:fontFamily="@font/poppins_medium"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/card_background">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:text="16 Digit Gift Card Number"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etGiftCardNumber"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="16 Digit Gift Card Number"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="number"
                android:maxLength="16"
                android:background="@drawable/edit_back"/>

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="Enter PIN"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etPin"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="Enter PIN"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="number"
                android:background="@drawable/edit_back"/>


        </LinearLayout>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnRedeem"
        style="@style/button"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_25sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:text="Redeem"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>