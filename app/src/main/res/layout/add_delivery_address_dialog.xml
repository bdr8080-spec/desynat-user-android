<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/_15sdp"
    android:background="@drawable/bottom_sheet"
    android:backgroundTint="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_15sdp"
        android:paddingHorizontal="@dimen/_15sdp"
        android:background="@drawable/bottom_sheet"
        android:backgroundTint="#FFF7EA"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/add_new_address_caps"
        android:textColor="@color/black"
        android:drawableEnd="@drawable/close_icon"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/tvToolbar"
        app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:id="@+id/llAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/card_background"
                android:padding="@dimen/_10sdp">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/name"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="@string/name"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:inputType="textCapSentences"
                    android:maxLength="30"
                    android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                    android:background="@drawable/edit_back"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="@string/mobile_no"
                    app:layout_constraintTop_toBottomOf="@+id/etFullName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:background="@drawable/edit_back"
                    app:layout_constraintTop_toBottomOf="@+id/tvMobile"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvCountryPicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/country_code_965"
                        android:paddingVertical="@dimen/_10sdp"
                        android:drawableEnd="@drawable/ic_drop_down"
                        android:drawablePadding="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/etMobile"
                        app:layout_constraintBottom_toBottomOf="@+id/etMobile"/>

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etMobile"
                        android:layout_width="0dp"
                        style="@style/edit_text"
                        android:hint="@string/mobile_no"
                        android:inputType="number"
                        android:maxLength="15"
                        android:background="@null"
                        android:paddingHorizontal="0dp"
                        android:layout_marginStart="@dimen/_5sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tvCountryPicker"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:visibility="gone"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="@string/address"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:visibility="gone"
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="@string/address"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:drawableEnd="@drawable/ic_current"
                    android:inputType="text"
                    android:editable="false"
                    android:focusable="false"
                    android:clickable="true"
                    android:background="@drawable/edit_back"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="@string/house_no_building_no_area"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etHouseNo"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="@string/house_no_building_no_area"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:inputType="text"
                    android:background="@drawable/edit_back"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:visibility="gone"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="@string/block_street"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:visibility="gone"
                    android:id="@+id/etBlock"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="@string/block_street"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:inputType="text"
                    android:background="@drawable/edit_back"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="@string/postal_code_optional"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etPostalCode"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="Postal Code"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:inputType="text"
                    android:maxLength="10"
                    android:background="@drawable/edit_back"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvCity"
                        android:layout_width="0dp"
                        style="@style/edit_text_title"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:text="@string/city_district"
                        android:layout_marginEnd="@dimen/_8sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tvState"/>

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etCity"
                        android:layout_width="0dp"
                        style="@style/edit_text"
                        android:hint="@string/city_district"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:inputType="text"
                        android:background="@drawable/edit_back"
                        app:layout_constraintTop_toBottomOf="@+id/tvCity"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/tvCity"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvState"
                        android:layout_width="0dp"
                        style="@style/edit_text_title"
                        android:text="@string/state"
                        android:layout_marginStart="@dimen/_7sdp"
                        app:layout_constraintTop_toTopOf="@+id/tvCity"
                        app:layout_constraintStart_toEndOf="@+id/tvCity"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etState"
                        android:layout_width="0dp"
                        style="@style/edit_text"
                        android:hint="@string/state"
                        android:inputType="text"
                        android:background="@drawable/edit_back"
                        app:layout_constraintTop_toTopOf="@+id/etCity"
                        app:layout_constraintStart_toStartOf="@+id/tvState"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="@string/landmark"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etLandmark"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="@string/landmark"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:inputType="text"
                    android:background="@drawable/edit_back"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnAdd"
                    style="@style/button"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="@string/add_address"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/llAddress"/>


            </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>