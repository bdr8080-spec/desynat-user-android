<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".ui.home.myOrder.OrderPaymentFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/btnProceed">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="@dimen/_15sdp">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="@string/select_payment_method"
                android:textSize="@dimen/_13sdp"
                android:fontFamily="@font/poppins_medium"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/grey_stroke_cards">

                    <LinearLayout
                        android:id="@+id/llKnet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:paddingVertical="@dimen/_5sdp"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivRadioKnet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_radio_unselected"
                            android:layout_gravity="center_vertical"/>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="34dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_knet"
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:layout_gravity="center_vertical"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/edit_text_title"
                            android:text="@string/pay_by_knet"
                            android:textSize="@dimen/_12sdp"
                            android:layout_gravity="center_vertical"
                            android:fontFamily="@font/poppins_medium"/>

                    </LinearLayout>

                <LinearLayout
                    android:id="@+id/llApplePay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivRadioApplePay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_radio_unselected"
                        android:layout_gravity="center_vertical"/>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="34dp"
                        android:layout_height="24dp"
                        android:src="@drawable/gpay"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_gravity="center_vertical"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/edit_text_title"
                        android:text="@string/google_pay"
                        android:textSize="@dimen/_12sdp"
                        android:layout_gravity="center_vertical"
                        android:fontFamily="@font/poppins_medium"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llVisa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivRadioVisa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_radio_unselected"
                        android:layout_gravity="center_vertical"/>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="34dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_visa"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_gravity="center_vertical"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/edit_text_title"
                        android:text="@string/visapay"
                        android:textSize="@dimen/_12sdp"
                        android:layout_gravity="center_vertical"
                        android:fontFamily="@font/poppins_medium"/>


                </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llSamsungPay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:paddingVertical="@dimen/_5sdp"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivSamsungPay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_radio_unselected"
                            android:layout_gravity="center_vertical"/>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="34dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_samsung"
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:layout_gravity="center_vertical"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/edit_text_title"
                            android:text="@string/samsung_pay"
                            android:textSize="@dimen/_12sdp"
                            android:layout_gravity="center_vertical"
                            android:fontFamily="@font/poppins_medium"/>

                    </LinearLayout>

                <LinearLayout
                    android:id="@+id/llCredit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivCredit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_radio_unselected"
                        android:layout_gravity="center_vertical"/>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="34dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_wallet"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_gravity="center_vertical"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/edit_text_title"
                        android:text="@string/credit_debit_card"
                        android:textSize="@dimen/_12sdp"
                        android:layout_gravity="center_vertical"
                        android:fontFamily="@font/poppins_medium"/>

                </LinearLayout>


                    <com.myfatoorah.sdk.views.embeddedpayment.MFPaymentCardView
                        android:visibility="gone"
                        android:id="@+id/mfPaymentView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:layout_marginHorizontal="@dimen/_15sdp"
                        app:layout_constraintTop_toBottomOf="@+id/llPaymentMethod"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:visibility="gone"
                        style="@style/edit_text_title"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:text="@string/add_new_card"
                        android:textSize="@dimen/_12sdp"
                        android:fontFamily="@font/poppins_medium"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/llWallet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivWallet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_radio_unselected"
                       app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/tvWallet"
                        android:layout_width="34dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_wallet"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        app:layout_constraintStart_toEndOf="@+id/ivWallet"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvInAppWallet"
                        style="@style/edit_text_title"
                        android:text="@string/in_app_wallet"
                        android:textSize="@dimen/_12sdp"
                        android:layout_width="0dp"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tvWallet"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:fontFamily="@font/poppins_medium"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvBalance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Available Balance : 349 KD"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_10sdp"
                        android:textAlignment="viewStart"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:fontFamily="@font/poppins_regular"
                        app:layout_constraintTop_toBottomOf="@+id/tvInAppWallet"
                        app:layout_constraintStart_toEndOf="@+id/tvWallet"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/llCod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivCod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_radio_unselected"
                        android:layout_gravity="center_vertical"/>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="34dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_wallet"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_gravity="center_vertical"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/edit_text_title"
                        android:layout_width="match_parent"
                        android:text="@string/cash_on_delivery"
                        android:textSize="@dimen/_12sdp"
                        android:textAlignment="viewStart"
                        android:fontFamily="@font/poppins_medium"/>

                </LinearLayout>

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/relGiftCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:background="@drawable/grey_stroke_cards">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivGift"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_gift_img"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvGiftCardNumber"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="123456789"
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_10sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:fontFamily="@font/poppins_regular"
                    app:layout_constraintStart_toEndOf="@+id/ivGift"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:drawableEnd="@drawable/ic_green_tick" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvHaveGiftCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/have_a_gift_card"
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/black"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_regular"
                    app:layout_constraintStart_toEndOf="@+id/ivGift"
                    app:layout_constraintEnd_toStartOf="@+id/tvApply"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvApply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/apply_gift_card"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/brown"
                    android:textSize="@dimen/_9sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:drawablePadding="@dimen/_5sdp"
                    android:padding="@dimen/_10sdp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvGiftCard"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="$ 100 Gift Card Amount Redeemed"
                android:textSize="@dimen/_11sdp"
                android:textColor="#17854C"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:fontFamily="@font/poppins_regular"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnProceed"
        style="@style/button"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_30sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:text="@string/place_order"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <com.myfatoorah.sdk.views.embeddedpayment.googlepay.MFGooglePayButton
        android:id="@+id/mfGooglePayButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>