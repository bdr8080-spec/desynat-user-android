<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.affiliateUser.home.AffiliateHomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF7EA"
        android:paddingBottom="@dimen/_10sdp"
        android:paddingTop="@dimen/_35sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProfile"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/_15sdp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_user"
            android:clipToOutline="true"
            app:shapeAppearanceOverlay="@style/circle_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Hi Will"
            android:textColor="@color/black"
            android:textSize="@dimen/_11sdp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginStart="@dimen/_5sdp"
            app:layout_constraintTop_toTopOf="@+id/ivProfile"
            app:layout_constraintEnd_toStartOf="@+id/ivSupport"
           app:layout_constraintStart_toEndOf="@+id/ivProfile"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvWelcome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:hint="@string/welcome"
            android:textColor="@color/black"
            android:textSize="@dimen/_11sdp"
            android:layout_marginEnd="@dimen/_2sdp"
            android:layout_marginStart="@dimen/_5sdp"
            app:layout_constraintTop_toBottomOf="@+id/tvName"
            app:layout_constraintEnd_toStartOf="@+id/ivSupport"
            app:layout_constraintStart_toEndOf="@+id/ivProfile"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivSupport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/_6sdp"
            android:paddingHorizontal="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:src="@drawable/support_bot_icon"
            app:layout_constraintTop_toTopOf="@+id/ivNotification"
            app:layout_constraintBottom_toBottomOf="@+id/ivNotification"
            app:layout_constraintEnd_toStartOf="@+id/ivNotification"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:src="@drawable/ic_bell"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivProfile"
            app:layout_constraintBottom_toBottomOf="@+id/ivProfile"/>

        <RelativeLayout
            android:visibility="gone"
            android:id="@+id/relCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="@dimen/_1sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_15sdp"
            app:layout_constraintTop_toTopOf="@+id/ivNotification"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:src="@drawable/circle_cart"
                android:layout_centerInParent="true"
                app:shapeAppearanceOverlay="@style/circle_image"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="visible"
                android:id="@+id/tvCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="1"
                android:layout_centerInParent="true"
                android:textColor="@color/white"
                android:textSize="@dimen/_8sdp"/>

        </RelativeLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/header_layout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF7EA">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvChooseDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/choose_date"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etFrom"
                    style="@style/edit_text"
                    android:layout_width="0dp"
                    android:paddingVertical="@dimen/_9sdp"
                    android:drawablePadding="@dimen/_5sdp"
                    android:hint="@string/from_date_hint"
                    android:editable="false"
                    android:clickable="true"
                    android:background="@drawable/stroke_cards"
                    android:focusable="false"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/poppins_light"
                    android:drawableEnd="@drawable/calendar_ic"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/etTo"
                    app:layout_constraintTop_toBottomOf="@+id/tvChooseDate"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etTo"
                    style="@style/edit_text"
                    android:layout_width="0dp"
                    android:paddingVertical="@dimen/_9sdp"
                    android:drawablePadding="@dimen/_5sdp"
                    android:hint="@string/to_date_hint"
                    android:editable="false"
                    android:clickable="true"
                    android:background="@drawable/stroke_cards"
                    android:focusable="false"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_light"
                    android:layout_centerVertical="true"
                    android:drawableEnd="@drawable/calendar_ic"
                    app:layout_constraintStart_toEndOf="@+id/etFrom"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="@+id/etFrom"
                    app:layout_constraintTop_toTopOf="@+id/etFrom"/>

                <RadioGroup
                    android:id="@+id/radioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="3"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    app:layout_constraintTop_toBottomOf="@+id/etFrom">

                    <RadioButton
                        android:id="@+id/rbToday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/today"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        android:paddingVertical="@dimen/_12sdp"
                        android:button="@drawable/selector_home_radio_icon"
                        android:paddingStart="@dimen/_8sdp"
                        android:checked="true"
                        app:buttonTint="@null"
                        android:drawableTint="@null"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="@dimen/_11sdp"/>

                    <RadioButton
                        android:id="@+id/rbWeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/this_week"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        android:paddingVertical="@dimen/_12sdp"
                        android:button="@drawable/selector_home_radio_icon"
                        android:paddingStart="@dimen/_8sdp"
                        android:checked="false"
                        app:buttonTint="@null"
                        android:drawableTint="@null"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="@dimen/_11sdp"/>

                    <RadioButton
                        android:id="@+id/rbMonth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/this_month"
                        android:textColor="@color/black"
                        android:paddingVertical="@dimen/_12sdp"
                        android:button="@drawable/selector_home_radio_icon"
                        android:paddingStart="@dimen/_8sdp"
                        android:checked="false"
                        app:buttonTint="@null"
                        android:drawableTint="@null"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="@dimen/_11sdp"/>

                </RadioGroup>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/radioGroup">

                <androidx.cardview.widget.CardView
                    android:id="@+id/revenueCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardBackgroundColor="#EEF9F1"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvRevenueGenrate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_15sdp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/total_revenue_generated"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_12sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/ivAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_15sdp"
                            android:layout_marginTop="@dimen/_15sdp"
                            android:fontFamily="@font/poppins_bold"
                            tools:text="129 KD"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_18sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvRevenueGenrate" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_15sdp"
                            android:layout_marginBottom="@dimen/_15sdp"
                            android:src="@drawable/revenue"
                            app:layout_constraintBottom_toBottomOf="@+id/ivAmount"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/ivAmount" />


                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvTotalProduct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_products_added"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginTop="20dp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    android:fontFamily="@font/poppins_bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/revenueCard" />

                <TextView
                    android:id="@+id/tvTotalProductCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(127)"
                    android:textColor="#F3D1A2"
                    android:textSize="@dimen/_11sdp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:fontFamily="@font/poppins_bold"
                    app:layout_constraintStart_toEndOf="@+id/tvTotalProduct"
                    app:layout_constraintTop_toTopOf="@+id/tvTotalProduct"
                    app:layout_constraintBottom_toBottomOf="@+id/tvTotalProduct"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/clActive"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginEnd="@dimen/_6sdp"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="1dp"
                    app:layout_constraintEnd_toStartOf="@+id/clInActive"
                    app:layout_constraintTop_toBottomOf="@+id/tvTotalProduct"
                    app:layout_constraintStart_toStartOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvActive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:text="@string/active"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/black"
                            android:layout_marginStart="@dimen/_15sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvActiveProduct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semi_bold"
                            android:text="120"
                            android:textColor="@color/black"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:textSize="@dimen/_18sdp"
                            app:layout_constraintStart_toStartOf="@+id/tvActive"
                            app:layout_constraintTop_toBottomOf="@+id/tvActive"/>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/parcel"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/clInActive"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:background="@drawable/stroke_cards"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:layout_marginStart="@dimen/_6sdp"
                    app:cardElevation="1dp"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:layout_constraintStart_toEndOf="@+id/clActive"
                    app:layout_constraintTop_toBottomOf="@+id/tvTotalProduct"
                    app:layout_constraintEnd_toEndOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvInActive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:text="@string/in_active"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="#F16767"
                            android:layout_marginStart="@dimen/_15sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvInActiveProduct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semi_bold"
                            android:text="120"
                            android:textColor="@color/black"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:textSize="@dimen/_18sdp"
                            app:layout_constraintStart_toStartOf="@+id/tvInActive"
                            app:layout_constraintTop_toBottomOf="@+id/tvInActive"/>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/parcel"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvTotalOrders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_orders"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginTop="20dp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    android:fontFamily="@font/poppins_bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/clActive" />

                <TextView
                    android:id="@+id/tvTotalOrdersCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(14)"
                    android:textColor="#F3D1A2"
                    android:textSize="@dimen/_11sdp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:fontFamily="@font/poppins_bold"
                    app:layout_constraintStart_toEndOf="@+id/tvTotalOrders"
                    app:layout_constraintTop_toTopOf="@+id/tvTotalOrders"
                    app:layout_constraintBottom_toBottomOf="@+id/tvTotalOrders"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/clNew"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:background="@drawable/stroke_cards"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toStartOf="@+id/clOngoing"
                    app:layout_constraintTop_toBottomOf="@+id/tvTotalOrders"
                    app:layout_constraintStart_toStartOf="parent"
                    app:cardElevation="1dp"
                    app:cardCornerRadius="@dimen/_10sdp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvNew"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:text="@string/new_text"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/black"
                            android:layout_marginStart="@dimen/_15sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvNewOrder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semi_bold"
                            android:text="120"
                            android:textColor="@color/black"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:textSize="@dimen/_18sdp"
                            app:layout_constraintStart_toStartOf="@+id/tvNew"
                            app:layout_constraintTop_toBottomOf="@+id/tvNew"/>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/parcel"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/clOngoing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:background="@drawable/stroke_cards"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:layout_marginStart="8dp"
                    app:layout_constraintStart_toEndOf="@+id/clNew"
                    app:layout_constraintTop_toBottomOf="@+id/tvTotalOrders"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:cardElevation="1dp"
                    app:cardCornerRadius="@dimen/_10sdp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvOnGoing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:text="@string/on_going"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/black"
                            android:layout_marginStart="@dimen/_15sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvOnGoingOrder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semi_bold"
                            android:text="120"
                            android:textColor="@color/black"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:textSize="@dimen/_18sdp"
                            app:layout_constraintStart_toStartOf="@+id/tvOnGoing"
                            app:layout_constraintTop_toBottomOf="@+id/tvOnGoing"/>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/parcel"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView
                    android:id="@+id/clcomplete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/stroke_cards"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toStartOf="@+id/clCancelled"
                    app:layout_constraintTop_toBottomOf="@+id/clNew"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginBottom="@dimen/_1sdp"
                    app:cardElevation="1dp"
                    app:cardCornerRadius="@dimen/_10sdp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvComplete"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:text="@string/completed"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/black"
                            android:layout_marginStart="@dimen/_15sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvCompleteOrder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semi_bold"
                            android:text="120"
                            android:textColor="@color/black"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:textSize="@dimen/_18sdp"
                            app:layout_constraintStart_toStartOf="@+id/tvComplete"
                            app:layout_constraintTop_toBottomOf="@+id/tvComplete"/>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/parcel"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/clCancelled"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/stroke_cards"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:layout_marginStart="8dp"
                    app:layout_constraintStart_toEndOf="@+id/clcomplete"
                    app:layout_constraintTop_toBottomOf="@+id/clOngoing"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:cardElevation="1dp"
                    app:cardCornerRadius="@dimen/_10sdp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvCancelled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:text="@string/cancelled"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="#F16767"
                            android:layout_marginStart="@dimen/_15sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvCancelledOrder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semi_bold"
                            android:text="120"
                            android:textColor="@color/black"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:textSize="@dimen/_18sdp"
                            app:layout_constraintStart_toStartOf="@+id/tvCancelled"
                            app:layout_constraintTop_toBottomOf="@+id/tvCancelled"/>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/parcel"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_20sdp"
                app:layout_constraintTop_toTopOf="@+id/ivGraph"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:visibility="gone"
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:indeterminate="true"
        android:indeterminateTint="@color/brown" />

</androidx.constraintlayout.widget.ConstraintLayout>