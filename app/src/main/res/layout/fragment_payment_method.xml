<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.giftCard.PaymentMethodFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/btnProceed">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/_15sdp">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="SELECT PAYMENT METHOD"
            android:textSize="@dimen/_13sdp"
            android:fontFamily="@font/poppins_medium"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/grey_stroke_cards">

            <LinearLayout
                android:id="@+id/llCredit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivCredit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_radio_unselected"
                    android:layout_gravity="center_vertical"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="34dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_wallet"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_gravity="center_vertical"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:text="Credit/ Debit Card"
                    android:textSize="@dimen/_12sdp"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="@font/poppins_medium"/>

            </LinearLayout>

            <com.myfatoorah.sdk.views.embeddedpayment.MFPaymentCardView
                android:visibility="gone"
                android:id="@+id/mfPaymentView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_marginHorizontal="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@+id/llPaymentMethod"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_15sdp"
                android:text="+ Add new card"
                android:textSize="@dimen/_12sdp"
                android:fontFamily="@font/poppins_medium"/>

            <LinearLayout
                android:id="@+id/llKnet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivRadioKnet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_radio_unselected"
                    android:layout_gravity="center_vertical"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="34dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_knet"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_gravity="center_vertical"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:text="Pay by KNET"
                    android:textSize="@dimen/_12sdp"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="@font/poppins_medium"/>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/llApplePay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivRadioApplePay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_radio_unselected"
                    android:layout_gravity="center_vertical"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="34dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_apple"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_gravity="center_vertical"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:text="Apple Pay"
                    android:textSize="@dimen/_12sdp"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="@font/poppins_medium"/>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/llVisa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivRadioVisa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_radio_unselected"
                    android:layout_gravity="center_vertical"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="34dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_visa"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_gravity="center_vertical"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:text="Visapay"
                    android:textSize="@dimen/_12sdp"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="@font/poppins_medium"/>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/llSamsungPay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivSamsungPay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_radio_unselected"
                    android:layout_gravity="center_vertical"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="34dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_samsung"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_gravity="center_vertical"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:text="Samsung Pay"
                    android:textSize="@dimen/_12sdp"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="@font/poppins_medium"/>

            </LinearLayout>

            <RelativeLayout
                android:id="@+id/llWallet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivWallet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_radio_unselected"
                    android:layout_gravity="center_vertical"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/tvWallet"
                    android:layout_width="34dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_wallet"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_toRightOf="@+id/ivWallet"
                    android:layout_gravity="center_vertical"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:text="In -App Wallet"
                    android:textSize="@dimen/_12sdp"
                    android:layout_gravity="center_vertical"
                    android:layout_toRightOf="@+id/tvWallet"
                    android:fontFamily="@font/poppins_medium"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available Balance : 349 KD"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_below="@+id/tvWallet"
                    android:layout_toRightOf="@+id/tvWallet"
                    android:layout_gravity="center_vertical"/>

            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnProceed"
        style="@style/button"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:text="Proceed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>