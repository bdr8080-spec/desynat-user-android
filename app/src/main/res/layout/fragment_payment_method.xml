<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.giftCard.PaymentMethodFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toTopOf="@+id/btnProceed">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/_15sdp">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="SELECT PAYMENT METHOD"
            android:textSize="@dimen/_13sdp"
            android:fontFamily="@font/poppins_medium"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/grey_stroke_cards">

            <RadioGroup
                android:id="@+id/rgPaymentMethods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbDebitCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Credit/ Debit Card"
                    android:drawablePadding="@dimen/_5sdp"
                    android:paddingStart="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp"
                    android:buttonTint="@color/brown"
                    android:drawableStart="@drawable/ic_wallet"/>

                <com.myfatoorah.sdk.views.embeddedpayment.MFPaymentCardView
                    android:visibility="gone"
                    android:id="@+id/mfPaymentView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    app:layout_constraintTop_toBottomOf="@+id/llPaymentMethod"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:visibility="gone"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:text="+ Add new card"
                    android:textSize="@dimen/_12sdp"
                    android:fontFamily="@font/poppins_medium"/>

                <RadioButton
                    android:id="@+id/rbKnet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pay by KNET"
                    android:drawablePadding="@dimen/_5sdp"
                    android:paddingStart="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:buttonTint="@color/brown"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:drawableStart="@drawable/ic_apple"/>

                <RadioButton
                    android:id="@+id/rbApplePay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apple Pay"
                    android:drawablePadding="@dimen/_5sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:paddingStart="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp"
                    android:buttonTint="@color/brown"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:drawableStart="@drawable/ic_apple"/>

                <RadioButton
                    android:id="@+id/rbVisaPay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visapay"
                    android:drawablePadding="@dimen/_5sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:paddingStart="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp"
                    android:buttonTint="@color/brown"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:drawableStart="@drawable/ic_visa"/>

                <RadioButton
                    android:id="@+id/rbSamsungPay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Samsung Pay"
                    android:drawablePadding="@dimen/_5sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:paddingStart="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp"
                    android:buttonTint="@color/brown"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:drawableStart="@drawable/ic_apple"/>

                <RadioButton
                    android:id="@+id/rbWallet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In -App Wallet"
                    android:drawablePadding="@dimen/_5sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:paddingStart="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp"
                    android:buttonTint="@color/brown"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:drawableStart="@drawable/ic_wallet"/>

            </RadioGroup>

        </LinearLayout>

        <RelativeLayout
            android:visibility="gone"
            android:id="@+id/relGiftCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:background="@drawable/grey_stroke_cards">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivGift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_gift_img"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvGiftCardNumber"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="123456789"
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/black"
                android:paddingVertical="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/poppins_regular"
                android:layout_toRightOf="@+id/ivGift"
                android:drawableEnd="@drawable/ic_green_tick"
                android:layout_centerVertical="true"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvHaveGiftCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Have a gift card"
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/black"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/poppins_regular"
                android:layout_toRightOf="@+id/ivGift"
                android:layout_centerVertical="true"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvApply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apply Gift Card"
                android:textSize="@dimen/_9sdp"
                android:textColor="@color/brown"
                android:padding="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/poppins_regular"
                android:layout_alignParentEnd="true"
                android:drawablePadding="@dimen/_5sdp"
                android:drawableEnd="@drawable/ic_go_arrow"
                android:layout_centerVertical="true"/>

        </RelativeLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvGiftCard"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="$ 100 Gift Card Amount Redeemed"
            android:textSize="@dimen/_11sdp"
            android:textColor="#17854C"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/poppins_regular"/>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnProceed"
        style="@style/button"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:text="Proceed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>