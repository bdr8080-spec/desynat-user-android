<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.auth.fragment.ForgotPasswordFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"
        app:layout_constraintTop_toTopOf="parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:paddingBottom="@dimen/_20sdp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:fontFamily="@font/poppins_medium"
                android:text="Please select an option to get verified then we’ll send an OTP to verify that it’s you"
                android:textColor="#80000000"
                android:textSize="@dimen/_10sdp"/>

            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/cbMobile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mobile Number"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="true"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

                <RadioButton
                    android:id="@+id/cbEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textColor="@color/black"
                    android:paddingVertical="@dimen/_12sdp"
                    android:button="@drawable/selector_radio_icon"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:paddingStart="@dimen/_8sdp"
                    android:checked="false"
                    app:buttonTint="@null"
                    android:drawableTint="@null"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"/>

            </RadioGroup>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvInputTitle"
                style="@style/edit_text_title"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Mobile Number"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:paddingHorizontal="@dimen/_10sdp"
                android:background="@drawable/edit_back">

                    <com.hbb20.CountryCodePicker
                        android:id="@+id/ccp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:ccp_showFlag="false"
                        app:ccp_showNameCode="false"
                        app:ccp_showArrow="false"
                        app:ccp_autoDetectCountry="false"
                        app:ccp_defaultNameCode="KW"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/etMobile"
                        app:layout_constraintBottom_toBottomOf="@+id/etMobile"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etMobile"
                    android:layout_width="0dp"
                    style="@style/edit_text"
                    android:hint="@string/enter_mobile_number"
                    android:inputType="number"
                    android:maxLength="15"
                    android:background="@null"
                    android:paddingHorizontal="0dp"
                    android:drawablePadding="@dimen/_10sdp"
                    android:drawableStart="@drawable/ic_drop_down"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ccp"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatEditText
                android:visibility="gone"
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                style="@style/edit_text"
                android:hint="@string/enter_email_address"
                android:layout_marginTop="@dimen/_5sdp"
                android:inputType="textEmailAddress"
                android:background="@drawable/edit_back" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnContinue"
                style="@style/button"
                android:layout_marginTop="@dimen/_30sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:text="@string/continue_text"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>