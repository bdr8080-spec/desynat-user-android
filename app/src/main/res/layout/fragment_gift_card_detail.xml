<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.giftCard.GiftCardDetailFragment">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_25sdp"
        android:paddingVertical="@dimen/_15sdp"
        android:paddingHorizontal="@dimen/_20sdp"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/details"
        android:textColor="@color/black"
        android:textSize="@dimen/_13sdp"
        android:textAlignment="center"
        android:drawableStart="@drawable/ic_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:layout_marginEnd="@dimen/_15sdp"
        android:text="06 Aug 25, 6:15 pm"
        android:textColor="@color/brown"
        android:textSize="@dimen/_10sdp"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/tvToolbar"
        app:layout_constraintTop_toTopOf="@+id/tvToolbar"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/tvToolbar"
        app:layout_constraintBottom_toBottomOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginHorizontal="@dimen/_15sdp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivGift"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_120sdp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_placeholder"
            app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvGiftName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Birthday Card"
            android:layout_marginTop="@dimen/_10sdp"
            android:textColor="#80000000"
            android:textSize="@dimen/_11sdp"
            android:textAlignment="viewStart"
            app:layout_constraintTop_toBottomOf="@+id/ivGift"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semi_bold"
            android:text="239 KD"
            android:textColor="@color/black"
            android:textSize="@dimen/_11sdp"
            android:textAlignment="viewEnd"
            app:layout_constraintTop_toTopOf="@+id/tvGiftName"
            app:layout_constraintBottom_toBottomOf="@+id/tvGiftName"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvRecepientDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/recepient_details"
            android:layout_marginTop="@dimen/_10sdp"
            android:textColor="#80000000"
            android:textSize="@dimen/_13sdp"
            android:textAlignment="viewStart"
            app:layout_constraintTop_toBottomOf="@+id/tvGiftName"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Atif Aslam"
            android:layout_marginTop="@dimen/_10sdp"
            android:textColor="@color/black"
            android:textSize="@dimen/_11sdp"
            android:textAlignment="viewStart"
            app:layout_constraintTop_toBottomOf="@+id/tvRecepientDetail"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Atif23@gmail.com"
            android:layout_marginTop="@dimen/_5sdp"
            android:textColor="@color/black"
            android:textSize="@dimen/_11sdp"
            android:textAlignment="viewStart"
            app:layout_constraintTop_toBottomOf="@+id/tvName"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Total Quantity- 2"
            android:layout_marginTop="@dimen/_5sdp"
            android:textColor="@color/black"
            android:textSize="@dimen/_11sdp"
            android:textAlignment="viewStart"
            app:layout_constraintTop_toBottomOf="@+id/tvEmail"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvFrom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/from"
            android:layout_marginTop="@dimen/_10sdp"
            android:textColor="#80000000"
            android:textSize="@dimen/_13sdp"
            android:textAlignment="viewStart"
            app:layout_constraintTop_toBottomOf="@+id/tvQuantity"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvFromName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Hasan Ali"
            android:layout_marginTop="@dimen/_10sdp"
            android:textColor="@color/black"
            android:textSize="@dimen/_11sdp"
            android:textAlignment="viewStart"
            app:layout_constraintTop_toBottomOf="@+id/tvFrom"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvWish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/wish_message"
            android:layout_marginTop="@dimen/_10sdp"
            android:textColor="#80000000"
            android:textSize="@dimen/_13sdp"
            android:textAlignment="viewStart"
            app:layout_constraintTop_toBottomOf="@+id/tvFromName"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvWishMessage"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:text="lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation."
            android:layout_marginTop="@dimen/_5sdp"
            android:gravity="start"
            android:textSize="@dimen/_10sdp"
            android:textAlignment="viewStart"
            android:background="@drawable/edit_back"
            app:layout_constraintTop_toBottomOf="@+id/tvWish"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/note"
            android:layout_marginTop="@dimen/_10sdp"
            android:textColor="#80000000"
            android:textSize="@dimen/_13sdp"
            android:textAlignment="viewStart"
            app:layout_constraintTop_toBottomOf="@+id/tvWishMessage"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvNoteMsg"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:textSize="@dimen/_10sdp"
            android:text="lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation."
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@drawable/edit_back"
            android:textAlignment="viewStart"
            app:layout_constraintTop_toBottomOf="@+id/tvNote"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPaid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/paid_by"
            android:layout_marginTop="@dimen/_10sdp"
            android:textColor="#80000000"
            android:textSize="@dimen/_12sdp"
            android:textAlignment="viewStart"
            app:layout_constraintTop_toBottomOf="@+id/tvNoteMsg"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTransaction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="124359526"
            android:textColor="@color/black"
            android:textSize="@dimen/_11sdp"
            android:textAlignment="viewEnd"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintTop_toTopOf="@+id/tvPaid"
            app:layout_constraintBottom_toBottomOf="@+id/tvPaid"
            app:layout_constraintStart_toEndOf="@+id/tvPaid"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/relPaidBy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:paddingVertical="@dimen/_10sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            android:background="@drawable/grey_stroke_cards"
            app:layout_constraintTop_toBottomOf="@+id/tvPaid">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPay"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_18sdp"
                android:src="@drawable/ic_visa"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="200 KD"
                android:layout_marginStart="@dimen/_5sdp"
                android:textColor="#80000000"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="viewStart"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivPay"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPayBy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="@string/paid_by_card"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="viewEnd"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60sdp"
            app:layout_constraintTop_toBottomOf="@+id/relPaidBy"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>