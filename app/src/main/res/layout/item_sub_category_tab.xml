<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_marginBottom="@dimen/_12sdp"
    android:layout_marginEnd="@dimen/_10sdp">

    <com.google.android.material.imageview.ShapeableImageView
        android:visibility="gone"
        android:id="@+id/ivAll"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_50sdp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_all"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <RelativeLayout
        android:id="@+id/relAllSelection"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/selected_sub_category_stroke"
        app:layout_constraintTop_toTopOf="@+id/ivAll"
        app:layout_constraintStart_toStartOf="@+id/ivAll"
        app:layout_constraintBottom_toBottomOf="@+id/ivAll"
        app:layout_constraintEnd_toEndOf="@+id/ivAll" />


    <View
        android:id="@+id/view"
        android:layout_width="0dp"
        android:layout_height="@dimen/_12sdp"
        app:layout_constraintTop_toBottomOf="@+id/ivAll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivSubCategory"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_50sdp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_placeholder"
        android:background="#F5F5F5"
        app:shapeAppearanceOverlay="@style/rounded_corner3sdp"
        app:layout_constraintTop_toBottomOf="@+id/view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:text="Puma"
        android:maxLines="2"
        android:textAlignment="center"
        android:layout_marginTop="@dimen/_5sdp"
        android:textColor="#7C7C7C"
        android:textSize="@dimen/_9sdp"
        app:layout_constraintTop_toBottomOf="@+id/ivSubCategory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <RelativeLayout
        android:id="@+id/relSelection"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/selected_sub_category_stroke"
        app:layout_constraintTop_toTopOf="@+id/ivSubCategory"
        app:layout_constraintStart_toStartOf="@+id/ivSubCategory"
        app:layout_constraintBottom_toBottomOf="@+id/ivSubCategory"
        app:layout_constraintEnd_toEndOf="@+id/ivSubCategory" />

</androidx.constraintlayout.widget.ConstraintLayout>