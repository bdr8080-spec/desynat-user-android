<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.giftCard.EnterGiftCardDetailFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/_15sdp">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="@string/choose_amount"
            android:textSize="@dimen/_13sdp"
            android:textAlignment="viewStart"
            android:fontFamily="@font/poppins_medium"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="3"
            android:layout_marginTop="@dimen/_10sdp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv100"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="100 KD"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/brown"
                android:paddingVertical="@dimen/_8sdp"
                android:gravity="center"
                android:background="@drawable/button_stroke"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv200"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="200 KD"
                android:gravity="center"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:textColor="@color/brown"
                android:background="@drawable/button_stroke"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEnterAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/enter_amount"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"
                android:gravity="center"
                android:paddingVertical="@dimen/_8sdp"
                android:textColor="@color/brown"
                android:background="@drawable/button_stroke"/>

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatEditText
            android:visibility="gone"
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="@string/enter_amount"
            android:layout_marginTop="@dimen/_10sdp"
            android:inputType="numberDecimal"
            android:maxLength="10"
            android:background="@drawable/edit_back"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="@string/recepient_details"
            android:textSize="@dimen/_13sdp"
            android:textAlignment="viewStart"
            android:fontFamily="@font/poppins_medium"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/name"
            android:textAlignment="viewStart"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="@string/enter_name"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="textCapSentences"
            android:maxLength="30"
            android:textAlignment="viewStart"
            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
            android:background="@drawable/edit_back"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="@string/email_id"
            android:textAlignment="viewStart"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="@string/enter_email_id"
            android:layout_marginTop="@dimen/_5sdp"
            android:textAlignment="viewStart"
            android:inputType="textEmailAddress"
            android:background="@drawable/edit_back"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="@string/whatsapp_number"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clMobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            android:background="@drawable/edit_back"
            app:layout_constraintTop_toBottomOf="@+id/tvMobile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCountryPicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="+965"
                android:paddingVertical="@dimen/_10sdp"
                android:drawableEnd="@drawable/ic_drop_down"
                android:drawablePadding="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/etMobile"
                app:layout_constraintBottom_toBottomOf="@+id/etMobile"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etMobile"
                android:layout_width="0dp"
                style="@style/edit_text"
                android:hint="@string/enter_mobile_number"
                android:inputType="number"
                android:maxLength="15"
                android:background="@null"
                android:paddingHorizontal="0dp"
                android:layout_marginStart="@dimen/_5sdp"
                android:textAlignment="viewStart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvCountryPicker"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="@string/from"
            android:textSize="@dimen/_13sdp"
            android:textAlignment="viewStart"
            android:fontFamily="@font/poppins_medium"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/name"
            android:textAlignment="viewStart"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etFromName"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="@string/enter_name"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="textCapSentences"
            android:maxLength="30"
            android:textAlignment="viewStart"
            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
            android:background="@drawable/edit_back"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="@string/wish_message"
            android:textAlignment="viewStart"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etWishMsg"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="@string/wish_message"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:lines="4"
            android:gravity="start"
            android:textAlignment="viewStart"
            android:background="@drawable/edit_back"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="@string/note"
            android:textAlignment="viewStart"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="@string/note"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="textMultiLine"
            android:gravity="start"
            android:maxLines="4"
            android:lines="4"
            android:textAlignment="viewStart"
            android:background="@drawable/edit_back"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnPay"
            style="@style/button"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="@string/pay"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"/>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>