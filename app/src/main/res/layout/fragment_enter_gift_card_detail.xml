<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.giftCard.EnterGiftCardDetailFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/_15sdp">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="Choose Amount"
            android:textSize="@dimen/_13sdp"
            android:fontFamily="@font/poppins_medium"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="3"
            android:layout_marginTop="@dimen/_10sdp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv100"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="100 KD"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/brown"
                android:paddingVertical="@dimen/_8sdp"
                android:gravity="center"
                android:background="@drawable/button_stroke"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv200"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="200 KD"
                android:gravity="center"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:textColor="@color/brown"
                android:background="@drawable/button_stroke"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEnterAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enter Amount"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"
                android:gravity="center"
                android:paddingVertical="@dimen/_8sdp"
                android:textColor="@color/brown"
                android:background="@drawable/button_stroke"/>

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatEditText
            android:visibility="gone"
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="Enter Amount"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="numberDecimal"
            android:maxLength="10"
            android:background="@drawable/edit_back"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="Recepient Details"
            android:textSize="@dimen/_13sdp"
            android:fontFamily="@font/poppins_medium"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="Name"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="Name"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="textCapSentences"
            android:maxLength="30"
            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
            android:background="@drawable/edit_back"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="Email ID"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="Name"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="textEmailAddress"
            android:background="@drawable/edit_back"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="From"
            android:textSize="@dimen/_13sdp"
            android:fontFamily="@font/poppins_medium"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="Name"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etFromName"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="Name"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="textCapSentences"
            android:maxLength="30"
            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
            android:background="@drawable/edit_back"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="Wish Message"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etWishMsg"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="Wish Message"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="textMultiLine"
            android:gravity="start"
            android:maxLines="4"
            android:lines="4"
            android:background="@drawable/edit_back"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/edit_text_title"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="Note"/>

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            style="@style/edit_text"
            android:hint="Note"
            android:layout_marginTop="@dimen/_5sdp"
            android:inputType="textMultiLine"
            android:gravity="start"
            android:maxLines="4"
            android:lines="4"
            android:background="@drawable/edit_back"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnPay"
            style="@style/button"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="Pay"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_20sdp"/>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>