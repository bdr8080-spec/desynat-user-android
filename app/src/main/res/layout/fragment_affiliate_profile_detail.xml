<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".ui.affiliateUser.home.profile.AffiliateProfileDetailFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/common_toolbar"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/llTab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_15sdp"
                android:orientation="horizontal"
                android:weightSum="3"
                android:background="@drawable/tab"
                app:layout_constraintTop_toBottomOf="@+id/rvHighlights">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPersonalInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Personal Info"
                    android:textSize="@dimen/_11sdp"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:background="@drawable/selected_left_tab"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/line_gradient"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/_8sdp"
                    android:layout_weight="0.9"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Address"
                    android:textSize="@dimen/_11sdp"
                    android:gravity="center"
                    android:textColor="@color/black"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/line_gradient"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvBank"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/_8sdp"
                    android:layout_weight="1.1"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Bank Account"
                    android:textSize="@dimen/_11sdp"
                    android:gravity="center"
                    android:textColor="@color/black"/>

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:visibility="visible"
                android:id="@+id/clPersonalInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvChangePassword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:paddingHorizontal="@dimen/_15sdp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Change Your Password"
                    android:textColor="@color/brown"
                    android:textSize="@dimen/_12sdp"
                    android:background="@drawable/card_background"
                    android:backgroundTint="@color/light_pink"
                    android:drawableEnd="@drawable/ic_arrow_forward"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfileImage"
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="@dimen/_60sdp"
                    android:src="@drawable/ic_user"
                    android:scaleType="centerCrop"
                    android:layout_marginTop="@dimen/_15sdp"
                    app:shapeAppearanceOverlay="@style/circle_image"
                    android:clipToOutline="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvChangePassword"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvChangeImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/stroke_cards"
                    android:text="Change Image"
                    android:paddingVertical="@dimen/_7sdp"
                    android:paddingHorizontal="@dimen/_7sdp"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:textColor="#9E7853"
                    android:textSize="@dimen/_10sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/ivProfileImage"
                    app:layout_constraintBottom_toBottomOf="@+id/ivProfileImage"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvFullName"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="Full Name"
                    app:layout_constraintTop_toBottomOf="@+id/ivProfileImage"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="Enter Full Name"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:inputType="textCapSentences"
                    android:maxLength="30"
                    android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                    android:background="@drawable/edit_back"
                    app:layout_constraintTop_toBottomOf="@+id/tvFullName"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvMobile"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="Mobile Number"
                    app:layout_constraintTop_toBottomOf="@+id/etFullName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etMobile"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="Mobile Number"
                    android:drawableEnd="@drawable/ic_change"
                    android:drawablePadding="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:inputType="textEmailAddress"
                    android:editable="false"
                    android:focusable="false"
                    android:clickable="true"
                    android:background="@drawable/edit_color_back"
                    app:layout_constraintTop_toBottomOf="@+id/tvMobile"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvEmail"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="Email Id"
                    app:layout_constraintTop_toBottomOf="@+id/etMobile"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="Email Address"
                    android:drawableEnd="@drawable/ic_change"
                    android:drawablePadding="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:editable="false"
                    android:focusable="false"
                    android:clickable="true"
                    android:inputType="textEmailAddress"
                    android:background="@drawable/edit_color_back"
                    app:layout_constraintTop_toBottomOf="@+id/tvEmail"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivDoc1"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_90sdp"
                    android:layout_marginTop="@dimen/_15sdp"
                    app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:background="@drawable/brown_dash_rectangle"
                    android:src="@drawable/doc1"
                    android:layout_marginEnd="@dimen/_5sdp"
                    app:layout_constraintTop_toBottomOf="@+id/etEmail"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ivDoc2"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivDoc2"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_90sdp"
                    app:shapeAppearanceOverlay="@style/rounded_corner4sdp"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:background="@drawable/brown_dash_rectangle"
                    android:src="@drawable/doc2"
                    android:layout_marginStart="@dimen/_5sdp"
                    app:layout_constraintTop_toTopOf="@+id/ivDoc1"
                    app:layout_constraintBottom_toBottomOf="@+id/ivDoc1"
                    app:layout_constraintStart_toEndOf="@+id/ivDoc1"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/llAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvCountry"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="Country"
                    android:layout_marginHorizontal="@dimen/_15sdp"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etCountry"
                    style="@style/edit_text"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:background="@drawable/edit_back"
                    android:clickable="true"
                    android:editable="false"
                    android:focusable="false"
                    android:hint="Country"
                    android:inputType="text"
                    android:drawableEnd="@drawable/ic_drop_down"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:text="Location"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etChooseLocation"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="Location"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:drawableEnd="@drawable/ic_current"
                    android:drawablePadding="@dimen/_5sdp"
                    android:drawableTint="#808080"
                    android:inputType="text"
                    android:editable="false"
                    android:focusable="false"
                    android:clickable="true"
                    android:background="@drawable/edit_back"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="Address Line 1"
                    android:layout_marginHorizontal="@dimen/_15sdp"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etAddressLine1"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="Enter House no., flat no..."
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:inputType="text"
                    android:editable="false"
                    android:focusable="false"
                    android:clickable="true"
                    android:background="@drawable/edit_back"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:text="Address Line 2"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etAddressLine2"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="Enter Street Name, Block, Apartment, Flat Name"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:inputType="text"
                    android:editable="false"
                    android:focusable="false"
                    android:clickable="true"
                    android:background="@drawable/edit_back"/>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:text="Pin Code"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etPinCode"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="Enter Pin Code"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:inputType="text"
                    android:background="@drawable/edit_back"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:visibility="gone"
                    style="@style/edit_text_title"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:text="Locality Town"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:visibility="gone"
                    android:id="@+id/etLocalityTown"
                    android:layout_width="match_parent"
                    style="@style/edit_text"
                    android:hint="Enter Locality Town"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:inputType="text"
                    android:background="@drawable/edit_back"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_15sdp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:visibility="gone"
                        android:id="@+id/tvState"
                        android:layout_width="0dp"
                        style="@style/edit_text_title"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:text="State"
                        android:layout_marginEnd="@dimen/_8sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tvCity"/>

                    <androidx.appcompat.widget.AppCompatEditText
                        android:visibility="gone"
                        android:id="@+id/etState"
                        android:layout_width="0dp"
                        style="@style/edit_text"
                        android:hint="Enter State Name"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:inputType="text"
                        android:background="@drawable/edit_back"
                        app:layout_constraintTop_toBottomOf="@+id/tvState"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/tvState"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:visibility="gone"
                        android:id="@+id/tvCity"
                        android:layout_width="0dp"
                        style="@style/edit_text_title"
                        android:text="City"
                        android:layout_marginStart="@dimen/_7sdp"
                        app:layout_constraintTop_toTopOf="@+id/tvState"
                        app:layout_constraintStart_toEndOf="@+id/tvState"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <androidx.appcompat.widget.AppCompatEditText
                        android:visibility="gone"
                        android:id="@+id/etCity"
                        android:layout_width="0dp"
                        style="@style/edit_text"
                        android:hint="Enter City Name"
                        android:inputType="text"
                        android:background="@drawable/edit_back"
                        app:layout_constraintTop_toTopOf="@+id/etState"
                        app:layout_constraintStart_toStartOf="@+id/tvCity"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/llBank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvBank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:listitem="@layout/item_bank"
                    android:layout_marginTop="@dimen/_10sdp"
                    tools:itemCount="2"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clAddAnotherAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    android:paddingVertical="@dimen/_8sdp"
                    android:layout_marginTop="@dimen/_30sdp"
                    android:background="@drawable/ic_add_another_account">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivAddNewBank"
                        android:layout_width="@dimen/_12sdp"
                        android:layout_height="@dimen/_12sdp"
                        android:src="@drawable/add_card"
                        android:layout_centerVertical="true"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintTop_toTopOf="@+id/tvAddNewBank"
                        app:layout_constraintBottom_toBottomOf="@+id/tvAddNewBank"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tvAddNewBank"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvAddNewBank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add another account"
                        android:gravity="center"
                        android:textColor="#6F4628"
                        android:textSize="@dimen/_12sdp"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginStart="@dimen/_5sdp"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivAddNewBank"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnSaveChange"
                style="@style/button"
                android:layout_marginBottom="@dimen/_30sdp"
                android:layout_marginTop="@dimen/_30sdp"
                android:text="Save Changes"
                android:layout_marginHorizontal="@dimen/_15sdp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>