<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_navigation_graph.xml"
    app:startDestination="@id/language">

    <fragment
        android:id="@+id/language"
        android:name="com.desynatuser.ui.auth.fragment.LanguageFragment"
        android:label="Language Fragment"
        tools:layout="@layout/fragment_language" >

        <action
            android:id="@+id/action_languageFragment_to_onBoardingFragment"
            app:destination="@id/onBoarding"/>

        <action
            android:id="@+id/action_languageFragment_to_loginFragment"
            app:destination="@id/login"/>

    </fragment>

    <fragment
        android:id="@+id/onBoarding"
        android:name="com.desynatuser.ui.auth.fragment.OnBoardingFragment"
        android:label="OnBoarding Fragment"
        tools:layout="@layout/fragment_on_boarding" >

        <action
            android:id="@+id/action_onBoardingFragment_to_LoginFragment"
            app:destination="@id/login"/>

        <action
            android:id="@+id/action_onBoardingFragment_to_affiliateSignUpFragment"
            app:destination="@id/affiliateSignUp"/>

    </fragment>

    <fragment
        android:id="@+id/login"
        android:name="com.desynatuser.ui.auth.fragment.LoginFragment"
        android:label="Login Fragment"
        tools:layout="@layout/fragment_login" >

        <action
            android:id="@+id/action_loginFragment_to_OtpFragment"
            app:destination="@id/otp"/>

<action
            android:id="@+id/action_loginFragment_to_BannerFragment"
            app:destination="@id/banner"/>

        <action
            android:id="@+id/action_loginFragment_to_forgotFragment"
            app:destination="@id/forgot"/>

        <action
            android:id="@+id/action_loginFragment_to_signUpFragment"
            app:destination="@id/signUp"/>

        <action
            android:id="@+id/action_loginFragment_to_affiliateSignUpFragment"
            app:destination="@id/affiliateSignUp"/>

        <action
            android:id="@+id/action_loginFragment_to_affiliateAddAddressFragment"
            app:destination="@id/affiliateAddAddress"/>

        <action
            android:id="@+id/action_loginFragment_to_affiliateAddBankDetailFragment"
            app:destination="@id/affiliateAddBankDetail"/>

    </fragment>

    <fragment
        android:id="@+id/banner"
        android:name="com.desynatuser.ui.auth.fragment.FullScreenBannerFragment"
        android:label="Full Screen Banner Fragment"
        tools:layout="@layout/fragment_full_screen_banner"/>

    <fragment
        android:id="@+id/otp"
        android:name="com.desynatuser.ui.auth.fragment.OtpVerificationFragment"
        android:label="Otp Fragment"
        tools:layout="@layout/fragment_otp_verification">

    <action
        android:id="@+id/action_otpFragment_to_resetPasswordFragment"
        app:destination="@id/resetPassword"/>

    <action
        android:id="@+id/action_otpFragment_to_bannerFragment"
        app:destination="@id/banner"/>

    <action
        android:id="@+id/action_otpFragment_to_affiliateAddAddressFragment"
        app:destination="@id/affiliateAddAddress"/>

    <action
        android:id="@+id/action_otpFragment_to_affiliateAddBankDetailFragment"
        app:destination="@id/affiliateAddBankDetail"/>

    <action
        android:id="@+id/action_otpFragment_to_affiliateSignUpFragment"
        app:destination="@id/affiliateSignUp"/>

    </fragment>

    <fragment
        android:id="@+id/forgot"
        android:name="com.desynatuser.ui.auth.fragment.ForgotPasswordFragment"
        android:label="Forgot Password Fragment"
        tools:layout="@layout/fragment_forgot_password">

    <action
        android:id="@+id/action_forgotFragment_to_otpFragment"
        app:destination="@id/otp"/>

        </fragment>

    <fragment
        android:id="@+id/resetPassword"
        android:name="com.desynatuser.ui.auth.fragment.ResetPasswordFragment"
        android:label="Reset Password Fragment"
        tools:layout="@layout/fragment_reset_password"/>

    <fragment
        android:id="@+id/signUp"
        android:name="com.desynatuser.ui.auth.fragment.SignUpFragment"
        android:label="SignUp Fragment"
        tools:layout="@layout/fragment_sign_up">

        <action
            android:id="@+id/action_signUpFragment_to_OtpFragment"
            app:destination="@id/otp"/>

    </fragment>


    <fragment
        android:id="@+id/affiliateSignUp"
        android:name="com.desynatuser.ui.affiliateUser.auth.AffiliateSignUpFragment"
        android:label="Affiliate SignUp Fragment"
        tools:layout="@layout/fragment_affiliate_sign_up">

        <action
            android:id="@+id/action_affiliateSignUpFragment_to_OtpFragment"
            app:destination="@id/otp"/>

        <action
            android:id="@+id/action_affiliateSignUpFragment_to_underReviewFragment"
            app:destination="@id/underReview"/>

    </fragment>

    <fragment
        android:id="@+id/affiliateAddAddress"
        android:name="com.desynatuser.ui.affiliateUser.auth.AffiliateAddAddressFragment"
        android:label="Affiliate AddA ddress Fragment"
        tools:layout="@layout/fragment_affiliate_add_address">

        <action
            android:id="@+id/action_affiliateAddAddressFragment_to_affiliateAddBankDetailFragment"
            app:destination="@id/affiliateAddBankDetail"/>

    </fragment>

    <fragment
        android:id="@+id/affiliateAddBankDetail"
        android:name="com.desynatuser.ui.affiliateUser.auth.BankDetailFragment"
        android:label="Affiliate Bank Detail Fragment"
        tools:layout="@layout/fragment_bank_detail">

        <action
            android:id="@+id/action_affiliateAddBankDetailFragment_to_underReviewFragment"
            app:destination="@id/underReview"/>

    </fragment>

    <fragment
        android:id="@+id/underReview"
        android:name="com.desynatuser.ui.affiliateUser.auth.UnderReviewFragment"
        android:label="Under Review Fragment"
        tools:layout="@layout/fragment_under_review"/>

</navigation>