<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/affiliate_home_navigation_graph"
    app:startDestination="@id/affiliateHome">

    <fragment
        android:id="@+id/affiliateHome"
        android:name="com.desynatuser.ui.affiliateUser.home.AffiliateHomeFragment"
        android:label="Affiliate Home Fragment"
        tools:layout="@layout/fragment_affiliate_home">

        <action
            android:id="@+id/action_affiliateHomeFragment_to_notificationFragment"
            app:destination="@id/affiliateNotification"/>

    </fragment>

    <fragment
        android:id="@+id/affiliateProfile"
        android:name="com.desynatuser.ui.affiliateUser.home.profile.AffiliateProfileFragment"
        android:label="Affiliate Profile Fragment"
        tools:layout="@layout/fragment_affiliate_profile">

        <action
            android:id="@+id/action_affiliateProfileFragment_to_affiliateProfileDetailFragment"
            app:destination="@id/affiliateProfileDetail"/>

        <action
            android:id="@+id/action_affiliateProfileFragment_to_myWithdrawalsFragment"
            app:destination="@id/myWithdrawalsFragment"/>

        <action
            android:id="@+id/action_affiliateProfileFragment_to_languageFragment"
            app:destination="@id/language"/>

        <action
            android:id="@+id/action_affiliateProfileFragment_to_changeCurrencyFragment"
            app:destination="@id/changeCurrency"/>

        <action
            android:id="@+id/action_affiliateProfileFragment_to_changeCountryFragment"
            app:destination="@id/changeCountry"/>

        <action
            android:id="@+id/action_affiliateProfileFragment_to_supportFragment"
            app:destination="@id/support"/>

        <action
            android:id="@+id/action_affiliateProfileFragment_to_settingFragment"
            app:destination="@id/setting"/>

        <action
            android:id="@+id/action_affiliateProfileFragment_to_faqFragment"
            app:destination="@id/faq"/>


    </fragment>

    <fragment
        android:id="@+id/otp"
        android:name="com.desynatuser.ui.auth.fragment.OtpVerificationFragment"
        android:label="Otp Fragment"
        tools:layout="@layout/fragment_otp_verification">

        <action
            android:id="@+id/action_otpFragment_to_affiliateChangeMobileFragment"
            app:destination="@id/affiliateChangeMobile"/>

    </fragment>

    <fragment
        android:id="@+id/affiliateProfileDetail"
        android:name="com.desynatuser.ui.affiliateUser.home.profile.AffiliateProfileDetailFragment"
        android:label="Affiliate Profile Detail Fragment"
        tools:layout="@layout/fragment_affiliate_profile_detail">

        <action
            android:id="@+id/action_affiliateProfileDetailFragment_to_affiliateAddBankDetailFragment"
            app:destination="@id/affiliateAddBankDetail"/>

        <action
            android:id="@+id/action_affiliateProfileFragment_to_changePasswordFragment"
            app:destination="@id/changePassword"/>

        <action
            android:id="@+id/action_affiliateProfileFragment_to_otpFragment"
            app:destination="@id/otp"/>

    </fragment>

    <fragment
        android:id="@+id/affiliateChangeMobile"
        android:name="com.desynatuser.ui.affiliateUser.home.profile.AffiliateChangeMobileFragment"
        android:label="Affiliate Change Mobile Fragment"
        tools:layout="@layout/fragment_change_mobile">

        <action
            android:id="@+id/action_affiliateChangeMobileFragment_to_otpFragment"
            app:destination="@id/otp"/>

    </fragment>

    <fragment
        android:id="@+id/affiliateCategory"
        android:name="com.desynatuser.ui.affiliateUser.home.product.AffiliateCategoryFragment"
        android:label="Affiliate Category Fragment"
        tools:layout="@layout/fragment_affiliate_category">

        <action
            android:id="@+id/action_affiliateCategoryFragment_to_affiliateAllProductFragment"
            app:destination="@id/affiliateAllProduct"/>

        <action
            android:id="@+id/action_affiliateCategoryFragment_to_searchProductFragment"
            app:destination="@id/searchAffiliateProduct"/>

    </fragment>

    <fragment
        android:id="@+id/searchAffiliateProduct"
        android:name="com.desynatuser.ui.affiliateUser.home.product.SearchAffiliateProductFragment"
        android:label="Search Affiliate Product Fragment"
        tools:layout="@layout/fragment_search_affiliate_product">

        <action
            android:id="@+id/action_searchProductFragment_to_searchAffiliateProductListFragment"
            app:destination="@id/searchAffiliateProductList"/>

    </fragment>

    <fragment
        android:id="@+id/searchAffiliateProductList"
        android:name="com.desynatuser.ui.affiliateUser.home.product.AffiliateSearchProductListFragment"
        android:label="Affiliate Search Product List Fragment"
        tools:layout="@layout/fragment_affiliate_search_product_list">

    </fragment>

    <fragment
        android:id="@+id/affiliateAllProduct"
        android:name="com.desynatuser.ui.affiliateUser.home.product.AffiliateAllProductFragment"
        android:label="Affiliate All Product Fragment"
        tools:layout="@layout/fragment_affiliate_all_product">

    </fragment>


    <fragment
        android:id="@+id/affiliateMyProduct"
        android:name="com.desynatuser.ui.affiliateUser.home.product.AffiliateMyProductFragment"
        android:label="Affiliate My Product Fragment"
        tools:layout="@layout/fragment_affiliate_my_product">

        <action
            android:id="@+id/action_affiliateMyProductFragment_to_affiliateItemPerformanceFragment"
            app:destination="@id/affiliateItemPerformance"/>

    </fragment>


    <fragment
        android:id="@+id/affiliateItemPerformance"
        android:name="com.desynatuser.ui.affiliateUser.home.product.ItemPerformanceFragment"
        android:label="Item Performance Fragment"
        tools:layout="@layout/fragment_item_performance"/>

    <fragment
        android:id="@+id/changePassword"
        android:name="com.desynatuser.ui.home.profile.ChangePasswordFragment"
        android:label="Change Password Fragment"
        tools:layout="@layout/fragment_change_password"/>

    <fragment
        android:id="@+id/affiliateAddBankDetail"
        android:name="com.desynatuser.ui.affiliateUser.auth.BankDetailFragment"
        android:label="Affiliate Bank Detail Fragment"
        tools:layout="@layout/fragment_bank_detail">

    </fragment>

    <fragment
        android:id="@+id/inAppCameraFragment"
        android:name="com.desynatuser.ui.InAppCameraFragment"
        android:label="In App Fragment"
        tools:layout="@layout/fragment_in_app_camera"/>

    <fragment
        android:id="@+id/affiliatePaymentFragment"
        android:name="com.desynatuser.ui.affiliateUser.home.payment.AffiliatePaymentFragment"
        android:label="Affiliate Payment Fragment"
        tools:layout="@layout/fragment_affiliate_payment">

        <action
            android:id="@+id/action_affiliatePaymentFragment_to_affiliateWithdrawMoneyFragment"
            app:destination="@id/affiliateWithdrawMoneyFragment"/>

    </fragment>

    <fragment
        android:id="@+id/affiliateWithdrawMoneyFragment"
        android:name="com.desynatuser.ui.affiliateUser.home.payment.AffiliateWithdrawMoneyFragment"
        android:label="Affiliate Withdraw Money Fragment"
        tools:layout="@layout/fragment_affiliate_withdraw_money">

        <action
            android:id="@+id/action_affiliateWithdrawMoneyFragment_to_affiliateAddBankDetailFragment"
            app:destination="@id/affiliateAddBankDetail"/>

    </fragment>

    <fragment
        android:id="@+id/myWithdrawalsFragment"
        android:name="com.desynatuser.ui.affiliateUser.home.payment.MyWithdrawalsFragment"
        android:label="My Withdrawals Fragment"
        tools:layout="@layout/fragment_my_withdrawals"/>

    <fragment
        android:id="@+id/changeCurrency"
        android:name="com.desynatuser.ui.home.cms.ChangeCurrencyFragment"
        android:label="Change Currency Fragment"
        tools:layout="@layout/fragment_change_currency"/>

    <fragment
        android:id="@+id/changeCountry"
        android:name="com.desynatuser.ui.home.cms.ChangeCountryFragment"
        android:label="Change Country Fragment"
        tools:layout="@layout/fragment_change_country"/>

    <fragment
        android:id="@+id/support"
        android:name="com.desynatuser.ui.home.cms.SupportFragment"
        android:label="Support Fragment"
        tools:layout="@layout/fragment_support"/>

    <fragment
        android:id="@+id/setting"
        android:name="com.desynatuser.ui.home.cms.SettingFragment"
        android:label="Setting Fragment"
        tools:layout="@layout/fragment_setting"/>

    <fragment
        android:id="@+id/faq"
        android:name="com.desynatuser.ui.home.cms.FaqFragment"
        android:label="Faq Fragment"
        tools:layout="@layout/fragment_faq"/>

    <fragment
        android:id="@+id/language"
        android:name="com.desynatuser.ui.auth.fragment.LanguageFragment"
        android:label="Language Fragment"
        tools:layout="@layout/fragment_language"/>

    <fragment
        android:id="@+id/affiliateNotification"
        android:name="com.desynatuser.ui.home.fragment.NotificationFragment"
        android:label="Notification Fragment"
        tools:layout="@layout/fragment_notification"/>

</navigation>