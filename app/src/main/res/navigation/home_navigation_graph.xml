<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_navigation_graph"
    app:startDestination="@id/home">

    <fragment
        android:id="@+id/home"
        android:name="com.desynatuser.ui.home.fragment.HomeFragment"
        android:label="Home Fragment"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_storeFragment"
            app:destination="@id/store"/>

        <action
            android:id="@+id/action_homeFragment_to_wishlistFragment"
            app:destination="@id/wishlist"/>

    </fragment>

    <fragment
        android:id="@+id/catalog"
        android:name="com.desynatuser.ui.home.catalog.CatalogFragment"
        android:label="Catalog Fragment"
        tools:layout="@layout/fragment_catalog">

        <action
            android:id="@+id/action_catalogFragment_to_subCategoryFragment"
            app:destination="@id/subCategory"/>

    </fragment>

    <fragment
        android:id="@+id/subCategory"
        android:name="com.desynatuser.ui.home.catalog.SubCategoryFragment"
        android:label="SubCategory Fragment"
        tools:layout="@layout/fragment_sub_category">

        <action
            android:id="@+id/action_subCategoryFragment_to_storeFragment"
            app:destination="@id/store"/>

        <action
            android:id="@+id/action_subCategoryFragment_to_searchProductFragment"
            app:destination="@id/searchProduct"/>

    </fragment>

    <fragment
        android:id="@+id/myBag"
        android:name="com.desynatuser.ui.home.fragment.MyBagFragment"
        android:label="My Bag Fragment"
        tools:layout="@layout/fragment_my_bag">

        <action
            android:id="@+id/action_myBagFragment_to_savedAddressFragment"
            app:destination="@id/savedAddress"/>

        <action
            android:id="@+id/action_myBagFragment_to_promoCodeFragment"
            app:destination="@id/promoCode"/>

        <action
            android:id="@+id/action_myBagFragment_to_paymentFragment"
            app:destination="@id/payment"/>

    </fragment>

    <fragment
        android:id="@+id/profile"
        android:name="com.desynatuser.ui.home.profile.ProfileFragment"
        android:label="Profile Fragment"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_profileFragment_to_profileDetailsFragment"
            app:destination="@id/profileDetails"/>

        <action
            android:id="@+id/action_profileFragment_to_savedAddressFragment"
            app:destination="@id/savedAddress"/>

        <action
            android:id="@+id/action_profileFragment_to_giftCardFragment"
            app:destination="@id/giftCard"/>

    </fragment>

    <fragment
        android:id="@+id/profileDetails"
        android:name="com.desynatuser.ui.home.profile.ProfileDetailFragment"
        android:label="Profile Details Fragment"
        tools:layout="@layout/fragment_profile_detail">

        <action
            android:id="@+id/action_profileDetailsFragment_to_changePasswordFragment"
            app:destination="@id/changePassword"/>

        <action
            android:id="@+id/action_profileDetailsFragment_to_otpFragment"
            app:destination="@id/otp"/>

    </fragment>

    <fragment
        android:id="@+id/otp"
        android:name="com.desynatuser.ui.auth.fragment.OtpVerificationFragment"
        android:label="Otp Fragment"
        tools:layout="@layout/fragment_otp_verification">

        <action
            android:id="@+id/action_otpFragment_to_changeMobileFragment"
            app:destination="@id/changeMobileEmail"/>

    </fragment>

    <fragment
        android:id="@+id/changePassword"
        android:name="com.desynatuser.ui.home.profile.ChangePasswordFragment"
        android:label="Change Password Fragment"
        tools:layout="@layout/fragment_change_password"/>

    <fragment
        android:id="@+id/changeMobileEmail"
        android:name="com.desynatuser.ui.home.profile.ChangeMobileFragment"
        android:label="Change Mobile Fragment"
        tools:layout="@layout/fragment_change_mobile">

    <action
        android:id="@+id/action_changeMobileEmailFragment_to_otpFragment"
        app:destination="@id/otp"/>

    </fragment>

    <fragment
        android:id="@+id/searchProduct"
        android:name="com.desynatuser.ui.home.store.ProductSearchFragment"
        android:label="Search Product Fragment"
        tools:layout="@layout/fragment_product_search">

        <action
            android:id="@+id/action_searchProductFragment_to_searchProductListFragment"
            app:destination="@id/searchProductList"/>

    </fragment>

    <fragment
        android:id="@+id/searchProductList"
        android:name="com.desynatuser.ui.home.store.SearchProductListFragment"
        android:label="Search Product List Fragment"
        tools:layout="@layout/fragment_search_product_list">

        <action
            android:id="@+id/action_storeFragment_to_productDetailFragment"
            app:destination="@id/productDetail"/>

    </fragment>

    <fragment
        android:id="@+id/store"
        android:name="com.desynatuser.ui.home.fragment.StoreFragment"
        android:label="Store Fragment"
        tools:layout="@layout/fragment_store">

        <action
            android:id="@+id/action_storeFragment_to_storeDetailFragment"
            app:destination="@id/storeDetail"/>

    </fragment>

    <fragment
        android:id="@+id/storeDetail"
        android:name="com.desynatuser.ui.home.store.StoreDetailFragment"
        android:label="Store Detail Fragment"
        tools:layout="@layout/fragment_store_detail">

        <action
            android:id="@+id/action_storeDetailFragment_to_productDetailFragment"
            app:destination="@id/productDetail"/>

    </fragment>

    <fragment
        android:id="@+id/productDetail"
        android:name="com.desynatuser.ui.home.store.ProductDetailFragment"
        android:label="Product Detail Fragment"
        tools:layout="@layout/fragment_product_detail">

        <action
            android:id="@+id/action_productDetailFragment_to_myBagFragment"
            app:destination="@id/myBag"/>

        <action
            android:id="@+id/action_productDetailFragment_to_savedAddressFragment"
            app:destination="@id/savedAddress"/>


    </fragment>

    <fragment
        android:id="@+id/addAddress"
        android:name="com.desynatuser.ui.home.profile.AddAddressFragment"
        android:label="Add Address Fragment"
        tools:layout="@layout/fragment_add_address"/>

    <fragment
        android:id="@+id/savedAddress"
        android:name="com.desynatuser.ui.home.profile.SavedAddressFragment"
        android:label="Saved Address Fragment"
        tools:layout="@layout/fragment_saved_address">

        <action
            android:id="@+id/action_savedAddressFragment_to_addAddressFragment"
            app:destination="@id/addAddress"/>

    </fragment>

    <fragment
        android:id="@+id/wishlist"
        android:name="com.desynatuser.ui.home.store.WishListFragment"
        android:label="Wishlist Fragment"
        tools:layout="@layout/fragment_wish_list"/>

    <fragment
        android:id="@+id/promoCode"
        android:name="com.desynatuser.ui.home.profile.PromoCodeFragment"
        android:label="Promo Code Fragment"
        tools:layout="@layout/fragment_promo_code"/>

    <fragment
        android:id="@+id/payment"
        android:name="com.desynatuser.ui.home.giftCard.PaymentMethodFragment"
        android:label="Payment Fragment"
        tools:layout="@layout/fragment_payment_method">

        <action
            android:id="@+id/action_paymentFragment_to_orderPlacedFragment"
            app:destination="@id/orderPlaced"/>

        <action
            android:id="@+id/action_paymentFragment_to_applyGiftFragment"
            app:destination="@id/giftCardApply"/>

    </fragment>

    <fragment
        android:id="@+id/giftCard"
        android:name="com.desynatuser.ui.home.giftCard.GiftCardFragment"
        android:label="Gift Card Fragment"
        tools:layout="@layout/fragment_gift_card">

        <action
            android:id="@+id/action_giftCardFragment_to_occasionTypeFragment"
            app:destination="@id/occasionType"/>

        <action
            android:id="@+id/action_giftCardFragment_to_giftCardDetailFragment"
            app:destination="@id/giftCardDetail"/>

    </fragment>

    <fragment
        android:id="@+id/enterGiftCardDetail"
        android:name="com.desynatuser.ui.home.giftCard.EnterGiftCardDetailFragment"
        android:label="Enter Gift Card Detail Fragment"
        tools:layout="@layout/fragment_enter_gift_card_detail">

        <action
            android:id="@+id/action_enterGiftCardDetailFragment_to_paymentFragment"
            app:destination="@id/payment"/>

    </fragment>

    <fragment
        android:id="@+id/giftCardDetail"
        android:name="com.desynatuser.ui.home.giftCard.GiftCardDetailFragment"
        android:label="Gift Card Detail Fragment"
        tools:layout="@layout/fragment_gift_card_detail"/>

    <fragment
        android:id="@+id/occasionType"
        android:name="com.desynatuser.ui.home.giftCard.SelectOccasionTypeFragment"
        android:label="Occasion Type Fragment"
        tools:layout="@layout/fragment_select_occasion_type">

        <action
            android:id="@+id/action_occasionTypeFragment_to_enterGiftCardDetailFragment"
            app:destination="@id/enterGiftCardDetail"/>

    </fragment>

    <fragment
        android:id="@+id/giftCardApply"
        android:name="com.desynatuser.ui.home.giftCard.ApplyGiftCardFragment"
        android:label="Apply Gift Card Fragment"
        tools:layout="@layout/fragment_apply_gift_card">

    </fragment>

    <fragment
        android:id="@+id/orderPlaced"
        android:name="com.desynatuser.ui.home.myOrder.OrderPlacedFragment"
        android:label="Order Placed Fragment"
        tools:layout="@layout/fragment_order_placed">

        <action
            android:id="@+id/action_orderPlacedFragment_to_myOrderFragment"
            app:destination="@id/myOrder"/>

    </fragment>

    <fragment
        android:id="@+id/myOrder"
        android:name="com.desynatuser.ui.home.myOrder.MyOrderFragment"
        android:label="My Order Fragment"
        tools:layout="@layout/fragment_my_order">

        <action
            android:id="@+id/action_myOrderFragment_to_myOrderFragment"
            app:destination="@id/enterGiftCardDetail"/>

    </fragment>

</navigation>