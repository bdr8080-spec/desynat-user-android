<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_navigation_graph"
    app:startDestination="@id/home">

    <fragment
        android:id="@+id/home"
        android:name="com.desynatuser.ui.home.fragment.HomeFragment"
        android:label="Home Fragment"
        tools:layout="@layout/fragment_home"/>

    <fragment
        android:id="@+id/catalog"
        android:name="com.desynatuser.ui.home.fragment.CatalogFragment"
        android:label="Catalog Fragment"
        tools:layout="@layout/fragment_catalog"/>

    <fragment
        android:id="@+id/myBag"
        android:name="com.desynatuser.ui.home.fragment.MyBagFragment"
        android:label="My Bag Fragment"
        tools:layout="@layout/fragment_my_bag"/>

    <fragment
        android:id="@+id/profile"
        android:name="com.desynatuser.ui.home.profile.ProfileFragment"
        android:label="Profile Fragment"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_profileFragment_to_profileDetailsFragment"
            app:destination="@id/profileDetails"/>

    </fragment>

    <fragment
        android:id="@+id/profileDetails"
        android:name="com.desynatuser.ui.home.profile.ProfileDetailFragment"
        android:label="Profile Details Fragment"
        tools:layout="@layout/fragment_profile_detail">

        <action
            android:id="@+id/action_profileDetailsFragment_to_changePasswordFragment"
            app:destination="@id/changePassword"/>

        <action
            android:id="@+id/action_profileDetailsFragment_to_otpFragment"
            app:destination="@id/otp"/>

    </fragment>

    <fragment
        android:id="@+id/otp"
        android:name="com.desynatuser.ui.auth.fragment.OtpVerificationFragment"
        android:label="Otp Fragment"
        tools:layout="@layout/fragment_otp_verification">

        <action
            android:id="@+id/action_otpFragment_to_changeMobileFragment"
            app:destination="@id/changeMobileEmail"/>

    </fragment>

    <fragment
        android:id="@+id/changePassword"
        android:name="com.desynatuser.ui.home.profile.ChangePasswordFragment"
        android:label="Change Password Fragment"
        tools:layout="@layout/fragment_change_password"/>

    <fragment
        android:id="@+id/changeMobileEmail"
        android:name="com.desynatuser.ui.home.profile.ChangeMobileFragment"
        android:label="Change Mobile Fragment"
        tools:layout="@layout/fragment_change_mobile">

    <action
        android:id="@+id/action_changeMobileEmailFragment_to_otpFragment"
        app:destination="@id/otp"/>

    </fragment>

</navigation>