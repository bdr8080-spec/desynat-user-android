<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.DesynatUser" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/brown</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- allow content to draw under status bar -->
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowLightStatusBar">false</item> <!-- white icons -->
    </style>

    <style name="Theme.DesynatUser" parent="Base.Theme.DesynatUser" />

    <style name="SplashViewTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsTranslucent">true</item>

    </style>

    <style name="WD_Slider" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        ...</style>


    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <style name="button" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/_12sdp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/btn_background</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:padding">@dimen/_10sdp</item>
        <item name="android:gravity">center</item>
    </style>


    <style name="edit_text_title" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/_11sdp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="singleLine">true</item>
    </style>


    <style name="edit_text" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/_12sdp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@drawable/edit_back</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="hintTextColor">@color/hint_color</item>
        <item name="singleLine">true</item>
        <item name="android:paddingVertical">@dimen/_11sdp</item>
        <item name="android:paddingHorizontal">@dimen/_10sdp</item>
    </style>

    <style name="CustomDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">80%</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="circle_image" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="rounded_corner_10sdp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_10sdp</item>
    </style>

    <style name="half_rounded_corner_10sdp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/_10sdp</item>
        <item name="cornerSizeTopRight">@dimen/_10sdp</item>
    </style>

    <style name="rounded_corner4sdp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_4sdp</item>
    </style>

    <style name="rounded_corner3sdp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_3sdp</item>
    </style>

    <style name="rounded_corner2sdp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/_2sdp</item>
    </style>

    <style name="rounded_corner_top_10sdp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/_10sdp</item>
        <item name="cornerSizeTopRight">@dimen/_10sdp</item>
    </style>

    <style name="DialogTheme" parent="Theme.AppCompat.Light.Dialog">

        <item name="colorPrimary">@color/brown</item>
        <item name="colorPrimaryDark">@color/brown</item>
        <item name="colorAccent">@color/brown</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/NegativeButtonStyle</item>

    </style>

    <style name="NegativeButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/brown</item>
    </style>

    <style name="checkbox" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/_11sdp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="hintTextColor">@color/black</item>
        <item name="android:paddingStart">@dimen/_8sdp</item>
        <item name="android:paddingTop">@dimen/_12sdp</item>
        <item name="android:paddingBottom">@dimen/_12sdp</item>
        <item name="buttonTint">@null</item>
        <item name="drawableTint">@null</item>
    </style>

    <style name="drawer_image" parent="">
        <item name="android:layout_width">@dimen/_20sdp</item>
        <item name="android:layout_height">@dimen/_20sdp</item>
        <item name="android:layout_centerVertical">true</item>
    </style>

    <style name="drawer_text" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/_11sdp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:layout_centerVertical">true</item>

    </style>

    <style name="drawer_arrow" parent="">
        <item name="android:layout_width">@dimen/_12sdp</item>
        <item name="android:layout_height">@dimen/_12sdp</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:src">@drawable/ic_arrow_next</item>
    </style>

</resources>